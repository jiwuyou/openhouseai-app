<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- External Termux tools and Ubuntu sessions use the installed Termux userspace. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="com.termux.SMALLPHONE_HOST" />
        </intent>
        <intent>
            <action android:name="com.termux.WUXIANPI_PREPARE_HOST" />
        </intent>
        <intent>
            <action android:name="com.termux.RUN_COMMAND" />
        </intent>
        <provider android:authorities="com.termux.documents" />
    </queries>

    <application
        android:name="com.openhouse.host.nativeapp.NativeOpenHouseApplication"
        android:allowBackup="false"
        android:label="WuxianPi"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WuxianPi"
        tools:replace="android:allowBackup,android:label,android:theme">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="com.ai.assistance.operit.provider.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.documents.workspace"
            tools:replace="android:authorities" />

        <provider
            android:name="com.ai.assistance.operit.provider.MemoryDocumentsProvider"
            android:authorities="${applicationId}.documents.memory"
            tools:replace="android:authorities" />

        <provider
            android:name="com.ai.assistance.operit.provider.OperitDataDocumentsProvider"
            android:authorities="${applicationId}.documents.data"
            tools:replace="android:authorities" />

        <receiver
            android:name="com.openhouse.host.nativeapp.NativeDefaultTermuxCommandResultReceiver"
            android:exported="false" />

        <receiver
            android:name="com.openhouse.host.nativeapp.NativeOpenHouseTermuxCommandResultReceiver"
            android:exported="false"
            android:process=":openhouse" />

        <receiver
            android:name="com.openhouse.host.nativeapp.NativeOperitTermuxCommandResultReceiver"
            android:exported="false"
            android:process=":operit" />

        <receiver
            android:name="com.openhouse.host.nativeapp.NativeRescueTermuxCommandResultReceiver"
            android:exported="false"
            android:process=":rescue_ui" />

        <receiver
            android:name="com.openhouse.host.nativeapp.NativeAdvancedUiTermuxCommandResultReceiver"
            android:exported="false"
            android:process=":advanced_ui" />

        <activity
            android:name="com.wuxianpi.openhouse.feature.OpenHouseActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:process=":openhouse"
            tools:replace="android:exported,android:launchMode,android:process">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ai.assistance.operit.ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":operit"
            tools:replace="android:exported,android:launchMode,android:process" />

        <activity
            android:name="com.wuxianpi.openhouse.feature.AdvancedUiActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":advanced_ui"
            tools:replace="android:exported,android:launchMode,android:process" />

        <activity
            android:name="live.pw.renderX.LatexView"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android-local second AI.  It keeps the complete Operit UI but runs in an isolated
             process so a Rust/JNI failure cannot take down the normal Node/Termux chat. -->
        <activity
            android:name="com.ai.assistance.operit.rescue.ui.RescueActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="@string/rescue_ai_title"
            android:process=":rescue_ui"
            android:theme="@style/Theme.Operit"
            tools:replace="android:exported,android:launchMode,android:process" />

        <activity
            android:name="com.wuxianpi.openhouse.servicecontrol.OpenHouseServiceControlActivity"
            android:exported="false"
            android:process=":openhouse"
            tools:replace="android:exported,android:process" />

        <activity
            android:name="com.openhouse.host.nativeapp.NativeRuntimeHostPreparationActivity"
            android:exported="false" />

        <activity
            android:name="com.openhouse.host.nativeapp.NativeTermuxHomeAccessActivity"
            android:exported="false" />

        <activity
            android:name="com.openhouse.host.nativeapp.NativeTermuxRunCommandPermissionActivity"
            android:exported="false" />
    </application>
</manifest>
