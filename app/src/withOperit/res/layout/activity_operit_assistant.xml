<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/panel"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/operitAssistantBack"
            android:layout_width="106dp"
            android:layout_height="46dp"
            android:background="@drawable/one_click_item_bg"
            android:minWidth="0dp"
            android:text="@string/operit_page_return_main_menu"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/operitAssistantTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/operit_page_assistant_title"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/operitAssistantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/operit_assistant_status_ready"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/operitAssistantOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/operitAssistantOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel"
            android:lineSpacingExtra="2dp"
            android:minHeight="240dp"
            android:padding="14dp"
            android:textColor="@color/textPrimary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:typeface="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/operit_assistant_quick_hint"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/operitQuickTermux"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/operit_assistant_quick_termux"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/operitQuickUbuntu"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/operit_assistant_quick_ubuntu"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/operitQuickServiceHealth"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/operit_assistant_quick_service_health"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/operitQuickServiceStatus"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/operit_assistant_quick_service_status"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/operitAssistantInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="4"
                android:minLines="2"
                android:hint="@string/operit_assistant_input_hint"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/operitAssistantSubmit"
                android:layout_width="86dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/operit_assistant_submit"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
