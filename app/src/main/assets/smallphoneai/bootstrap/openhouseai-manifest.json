{
  "schema": 1,
  "version": "2026.06.11.1",
  "title": "SmallPhoneAI 维护器",
  "sourceName": "SmallPhoneAI APK 维护源",
  "updatedAt": "2026-06-11",
  "bootstrapUrl": "https://raw.githubusercontent.com/jiwuyou/openhouseai-bootstrap/main/bootstrap.sh",
  "bootstrapUrlRole": "optional_update_only",
  "defaultOneClickAction": "install",
  "machineReadable": {
    "status": { "type": "bootstrap", "args": ["status"], "output": "json" },
    "check": { "type": "bootstrap", "args": ["check"], "output": "json" },
    "hooks": { "type": "bootstrap", "args": ["hooks"], "output": "json" },
    "postApkUpdate": {
      "type": "bootstrap",
      "args": ["sync-core-stack"],
      "reportsFinalHealth": true,
      "finalHealth": { "format": "json", "source": "final stdout object" }
    }
  },
  "runtimePayloads": {
    "firstRunSource": "apk_bundled",
    "networkRole": "optional_update_only",
    "apkAssetRoot": "openhouse/product-payloads",
    "extractedRoot": "$HOME/.smallphoneai-bootstrap/apk-assets/openhouse/product-payloads",
    "installRoot": "$HOME/smallphoneai-repos",
    "requiredEntries": ["scripts/install.sh", "scripts/check.sh"],
    "payloads": [
      {
        "id": "service-manager",
        "title": "service-manager",
        "apkAssetPath": "openhouse/product-payloads/service-manager.tar",
        "targetDir": "$HOME/smallphoneai-repos/service-manager"
      },
      {
        "id": "openhouse-connect",
        "title": "cc-connect/openhouse-connect",
        "apkAssetPath": "openhouse/product-payloads/openhouse-connect.tar",
        "targetDir": "$HOME/smallphoneai-repos/openhouse-connect"
      },
      {
        "id": "smallphone",
        "title": "SmallPhone",
        "apkAssetPath": "openhouse/product-payloads/smallphone.tar",
        "targetDir": "$HOME/smallphoneai-repos/smallphone-active"
      }
    ]
  },
  "stageFlow": [
    {
      "title": "准备手机环境",
      "description": "准备 Termux、Ubuntu、文档路径和基础依赖。",
      "stages": ["env_check", "prepare", "termux_packages", "install_ubuntu", "sync_official_docs", "ubuntu_packages"]
    },
    {
      "title": "安装 Agent CLI",
      "description": "安装或检查 OpenCode、Codex、Claude Code 和 Reasonix。",
      "stages": ["entry_ubuntu", "install_opencode", "install_codex", "install_claude_code", "install_reasonix"]
    },
    {
      "title": "安装 SmallPhone 运行组件",
      "description": "从 APK-bundled payloads 安装 service-manager、cc-connect/openhouse-connect、SmallPhone，并调用各自 install/check/register-service 入口。",
      "stages": ["runtime_components"]
    },
    {
      "title": "启动 SmallPhone",
      "description": "启动 service-manager，通过 group:local-stack 启动已注册服务，并读取最终健康状态。",
      "stages": ["start"]
    }
  ],
  "sections": [
    {
      "id": "smallphone_runtime",
      "type": "actions",
      "title": "SmallPhone 运行栈",
      "description": "面向 App Shell 的安装、检查、启动和修复入口；所有动作可重复执行。",
      "items": [
        {
          "id": "install",
          "type": "button",
          "label": "安装 SmallPhoneAI",
          "description": "完整准备环境、安装 Agent CLI、安装运行组件、启动 SmallPhone，并输出最终健康状态。",
          "action": {
            "type": "bootstrap",
            "args": ["install"],
            "reportsFinalHealth": true,
            "finalHealth": { "format": "json", "source": "final stdout object" }
          }
        },
        {
          "id": "status",
          "type": "button",
          "label": "读取状态 JSON",
          "description": "输出 SmallPhoneAI 机器可读状态。",
          "action": { "type": "bootstrap", "args": ["status"], "output": "json" }
        },
        {
          "id": "start",
          "type": "button",
          "label": "启动 SmallPhone",
          "description": "启动 service-manager，请求启动 group:local-stack，并输出最终健康状态。",
          "action": {
            "type": "bootstrap",
            "args": ["start"],
            "reportsFinalHealth": true,
            "finalHealth": { "format": "json", "source": "final stdout object" }
          }
        },
        {
          "id": "repair",
          "type": "button",
          "label": "修复 SmallPhone",
          "description": "重新执行运行组件 install/check/register-service，然后启动并输出状态。",
          "action": {
            "type": "bootstrap",
            "args": ["repair"],
            "reportsFinalHealth": true,
            "finalHealth": { "format": "json", "source": "final stdout object" }
          }
        },
        {
          "id": "sync_core_stack",
          "type": "button",
          "label": "同步核心运行栈",
          "description": "APK 更新后同步内置 service-manager、openhouse-connect、SmallPhone 核心组件，刷新 registry 并启动本机服务；不会执行首次安装的 apt/AI CLI 阶段。",
          "action": {
            "type": "bootstrap",
            "args": ["sync-core-stack"],
            "reportsFinalHealth": true,
            "finalHealth": { "format": "json", "source": "final stdout object" }
          }
        }
      ]
    },
    {
      "id": "agent_cli_repair",
      "type": "actions",
      "title": "AI 工具补装与修复",
      "description": "单独补装或检查 OpenCode、Codex、Claude Code、Reasonix。",
      "items": [
        {
          "id": "install_opencode",
          "type": "button",
          "label": "安装 OpenCode",
          "description": "在 Ubuntu 内安装或检查 OpenCode。",
          "action": { "type": "bootstrap", "args": ["opencode"] }
        },
        {
          "id": "install_codex",
          "type": "button",
          "label": "安装 Codex",
          "description": "在 Ubuntu 内安装 OpenAI Codex CLI。",
          "action": { "type": "bootstrap", "args": ["codex"] }
        },
        {
          "id": "install_claude_code",
          "type": "button",
          "label": "安装 Claude Code",
          "description": "在 Ubuntu 内安装 Anthropic Claude Code。",
          "action": { "type": "bootstrap", "args": ["claude-code"] }
        },
        {
          "id": "install_reasonix",
          "type": "button",
          "label": "安装 Reasonix",
          "description": "在 Ubuntu 内安装 DeepSeek-native Reasonix。",
          "action": { "type": "bootstrap", "args": ["reasonix"] }
        }
      ]
    }
  ],
  "stages": [
    {
      "id": "env_check",
      "title": "检查 Termux",
      "description": "检查当前是否为支持的 Termux/Ubuntu 环境。",
      "action": { "type": "bootstrap", "args": ["env-check"] }
    },
    {
      "id": "prepare",
      "title": "准备 Termux",
      "description": "创建 SmallPhoneAI 文档目录、工作区和 Termux 配置。",
      "action": { "type": "bootstrap", "args": ["prepare"] }
    },
    {
      "id": "termux_packages",
      "title": "安装 Termux 基础包",
      "description": "pkg 安装 proot-distro、curl、openssl、ca-certificates。",
      "action": { "type": "bootstrap", "args": ["termux-packages"] }
    },
    {
      "id": "install_ubuntu",
      "title": "安装 Ubuntu rootfs",
      "description": "通过 proot-distro 安装可重复进入的 Ubuntu rootfs。",
      "action": { "type": "bootstrap", "args": ["ubuntu"] }
    },
    {
      "id": "sync_official_docs",
      "title": "同步说明文档",
      "description": "同步 SmallPhoneAI 文档到 ~/smallphoneai-docs/official。",
      "action": { "type": "bootstrap", "args": ["sync-docs"] }
    },
    {
      "id": "ubuntu_packages",
      "title": "安装 Ubuntu 基础包",
      "description": "apt 安装 curl、ca-certificates、git、procps、ripgrep、unzip。",
      "action": { "type": "bootstrap", "args": ["ubuntu-packages"] }
    },
    {
      "id": "entry_ubuntu",
      "title": "启动后直接进入 Ubuntu",
      "description": "设置打开 Termux 后默认进入 Ubuntu。",
      "action": { "type": "bootstrap", "args": ["entry-ubuntu"] }
    },
    {
      "id": "install_opencode",
      "title": "安装 OpenCode",
      "description": "通过 npm 安装或检查 opencode-ai。",
      "action": { "type": "bootstrap", "args": ["opencode"] }
    },
    {
      "id": "install_codex",
      "title": "安装 Codex CLI",
      "description": "通过 npm 安装或检查 @openai/codex。",
      "action": { "type": "bootstrap", "args": ["codex"] }
    },
    {
      "id": "install_claude_code",
      "title": "安装 Claude Code",
      "description": "通过 npm 安装或检查 @anthropic-ai/claude-code。",
      "action": { "type": "bootstrap", "args": ["claude-code"] }
    },
    {
      "id": "install_reasonix",
      "title": "安装 Reasonix",
      "description": "通过 npm 安装或检查 reasonix。",
      "action": { "type": "bootstrap", "args": ["reasonix"] }
    },
    {
      "id": "runtime_components",
      "title": "安装运行组件",
      "description": "从 APK-bundled payloads 安装、检查并注册 service-manager、cc-connect/openhouse-connect、SmallPhone。",
      "action": { "type": "bootstrap", "args": ["components"] }
    },
    {
      "id": "start",
      "title": "启动 SmallPhone",
      "description": "启动 service-manager，通过 group:local-stack 启动 SmallPhone 运行栈，并输出最终健康状态。",
      "action": {
        "type": "bootstrap",
        "args": ["start"],
        "reportsFinalHealth": true,
        "finalHealth": { "format": "json", "source": "final stdout object" }
      }
    },
    {
      "id": "repair",
      "title": "修复 SmallPhone",
      "description": "重新安装/检查/注册运行组件，启动后输出状态 JSON。",
      "action": {
        "type": "bootstrap",
        "args": ["repair"],
        "reportsFinalHealth": true,
        "finalHealth": { "format": "json", "source": "final stdout object" }
      }
    },
    {
      "id": "sync_core_stack",
      "title": "同步核心运行栈",
      "description": "APK 更新后同步内置运行组件、registry 和本机服务状态，不执行首次安装的系统包或 AI CLI 安装阶段。",
      "action": {
        "type": "bootstrap",
        "args": ["sync-core-stack"],
        "reportsFinalHealth": true,
        "finalHealth": { "format": "json", "source": "final stdout object" }
      }
    },
    {
      "id": "status",
      "title": "状态 JSON",
      "description": "输出机器可读状态，供 App Shell 解析。",
      "action": { "type": "bootstrap", "args": ["status"], "output": "json" }
    }
  ]
}
