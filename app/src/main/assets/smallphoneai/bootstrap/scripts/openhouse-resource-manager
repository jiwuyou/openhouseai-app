#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
MANAGER_ROOT="${OPENHOUSEAI_RESOURCE_MANAGER_ROOT:-$HOME/.local/share/openhouseai/resource-manager}"
INSTALL_ROOT="${OPENHOUSEAI_RESOURCE_INSTALL_ROOT:-$HOME/.local/share/openhouseai/resources}"
RECEIPTS="$MANAGER_ROOT/receipts/resources"
TRANSACTIONS="$MANAGER_ROOT/transactions"
FAILED="$MANAGER_ROOT/failed"
INSTALLED_SET="$MANAGER_ROOT/installed-set.json"
PREVIOUS_SET="$MANAGER_ROOT/previous-set.json"
LOCK_FILE="$MANAGER_ROOT/update.lock"
LEGACY="$MANAGER_ROOT/legacy"
SET_FILE="${OPENHOUSEAI_RESOURCE_SET_FILE:-}"
SOURCE_DIR="${OPENHOUSEAI_RESOURCE_SOURCE_DIR:-}"
MARKET_ORIGIN="${OPENHOUSEAI_RESOURCE_MARKET_ORIGIN:-https://wuxianpirescue.webefficacy.com}"
OFFICIAL_MARKET_ORIGIN="https://wuxianpirescue.webefficacy.com"
MARKET_CACHE="$MANAGER_ROOT/market-cache"
COMMAND="${1:-inspect}"
FORCE_RESOURCE=""
CURRENT_TRANSACTION=""
FAILED_STEP="initializing"

log() { printf '[resource-manager] %s\n' "$*"; }
die() { printf '[resource-manager] ERROR: %s\n' "$*" >&2; exit 1; }

require_tools() {
  local tool
  for tool in jq tar gzip find sort awk sed readlink flock stat tee mktemp; do
    command -v "$tool" >/dev/null 2>&1 || die "missing required command: $tool"
  done
}

require_market_tools() {
  local tool
  for tool in curl sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || die "missing required market command: $tool"
  done
}

setup_dirs() {
  mkdir -p "$RECEIPTS" "$TRANSACTIONS" "$FAILED" "$INSTALL_ROOT" "$LEGACY/receipts" "$MARKET_CACHE"
  chmod 700 "$MANAGER_ROOT" "$RECEIPTS" "$TRANSACTIONS" "$FAILED" "$INSTALL_ROOT" "$LEGACY" "$LEGACY/receipts" "$MARKET_CACHE"
  local receipt schema name
  for receipt in "$RECEIPTS"/*.json; do
    [[ -f "$receipt" ]] || continue
    schema="$(jq -r '.schema // 0' "$receipt" 2>/dev/null || printf 0)"
    [[ "$schema" == 3 || "$schema" == 4 ]] && continue
    name="$(basename "$receipt" .json)-$(date -u +%Y%m%dT%H%M%SZ).json"
    mv "$receipt" "$LEGACY/receipts/$name"
  done
  if [[ -f "$INSTALLED_SET" ]] && ! jq -e '(.schema == 3 or .schema == 4)' "$INSTALLED_SET" >/dev/null 2>&1; then
    mv "$INSTALLED_SET" "$LEGACY/installed-set-$(date -u +%Y%m%dT%H%M%SZ).json"
  fi
}

atomic_file() {
  local source="$1" target="$2" temporary
  temporary="$target.tmp.$$"
  install -m 600 "$source" "$temporary"
  mv -f "$temporary" "$target"
}

atomic_json() {
  local content="$1" target="$2" temporary
  temporary="$target.tmp.$$"
  printf '%s\n' "$content" >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$target"
}

safe_value() {
  [[ "$1" != *$'\t'* && "$1" != *$'\n'* && "$1" != *'/'* && "$1" != *'..'* ]] \
    || die "unsafe resource value: $1"
}

read_set() {
  local file="$1"
  [[ -f "$file" ]] || die "resource set is missing: $file"
  jq -e '
    .schema == 2 and .id == "openhouse-core-stack" and
    (.version | type == "string" and length > 0) and
    (.sequence | type == "number" and . > 0) and .abi == "arm64-v8a" and
    (([.resources[].id] | sort) == ["openhouse-control-plane","openhouse-runtime","openhouse-web","service-manager","wuyou"] or
     ([.resources[].id] | sort) == ["openhouse-control-plane-start","openhouse-inspect-control-plane","openhouse-install-runtime-components","openhouse-register-component","openhouse-repair-control-plane","openhouse-resource-import","openhouse-resource-manager","openhouse-runtime","openhouse-start-service-manager","openhouse-start-smallphone","openhouse-termux-services-env","openhouse-web","service-manager","wuxianpi-setup","wuyou"]) and
    ([.resources[].id] | length) == ([.resources[].id] | unique | length)
  ' "$file" >/dev/null || die "resource set structure is invalid"
  jq -e '
    {"service-manager":"service-manager.tgz",
      "openhouse-control-plane":"openhouse-control-plane.tgz",
      "openhouse-runtime":"runtime-aarch64.tgz",
      "wuyou":"wuyou.tgz",
      "openhouse-web":"openhouse-web.tgz",
      "openhouse-resource-manager":"openhouse-resource-manager.tgz",
      "openhouse-resource-import":"openhouse-resource-import.tgz",
      "wuxianpi-setup":"wuxianpi-setup.tgz",
      "openhouse-install-runtime-components":"openhouse-install-runtime-components.tgz",
      "openhouse-start-smallphone":"openhouse-start-smallphone.tgz",
      "openhouse-register-component":"openhouse-register-component.tgz",
      "openhouse-control-plane-start":"openhouse-control-plane-start.tgz",
      "openhouse-termux-services-env":"openhouse-termux-services-env.tgz",
      "openhouse-start-service-manager":"openhouse-start-service-manager.tgz",
      "openhouse-repair-control-plane":"openhouse-repair-control-plane.tgz",
      "openhouse-inspect-control-plane":"openhouse-inspect-control-plane.tgz"} as $archives |
    all(.resources[]; $archives[.id] == .archive) and
    all(.resources[]; (.sha256 | type == "string" and test("^[a-f0-9]{64}$"))) and
    all(.resources[]; (.size | type == "number" and . > 0 and . <= 62914560))
  ' "$file" >/dev/null || die "resource archive mapping is invalid"
}

resource_rows() {
  jq -r '.resources[] | [.id,.version,.archive,.size,.sha256] | @tsv' "$1"
}

archive_for() {
  local id="$1" archive="$2" candidate
  [[ -n "$SOURCE_DIR" ]] || die "resource source directory is not set"
  candidate="$SOURCE_DIR/$archive"
  if [[ -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  candidate="$SOURCE_DIR/$id/$archive"
  [[ -f "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

resource_required() {
  case "$1" in
    service-manager) [[ -x "$2/service-manager" && -x "$2/scripts/install.sh" && -x "$2/scripts/check.sh" ]] ;;
    openhouse-control-plane) [[ -x "$2/start-control-plane-termux-native.sh" ]] ;;
    openhouse-runtime) [[ -x "$2/install.sh" && -x "$2/scripts/check.sh" && -x "$2/scripts/register-service.sh" ]] ;;
    wuyou) [[ -x "$2/wuyou" && -x "$2/scripts/install.sh" && -x "$2/scripts/check.sh" && -x "$2/scripts/register-service.sh" ]] ;;
    openhouse-web) [[ -x "$2/scripts/install.sh" && -x "$2/scripts/check.sh" && -x "$2/scripts/register-service.sh" ]] ;;
    openhouse-resource-manager) [[ -x "$2/openhouse-resource-manager" ]] ;;
    openhouse-resource-import) [[ -x "$2/openhouse-resource-import" ]] ;;
    wuxianpi-setup) [[ -x "$2/wuxianpi-setup" ]] ;;
    openhouse-install-runtime-components) [[ -x "$2/50-install-runtime-components.sh" ]] ;;
    openhouse-start-smallphone) [[ -x "$2/60-start-smallphone.sh" ]] ;;
    openhouse-register-component) [[ -x "$2/register-openhouse-component.sh" ]] ;;
    openhouse-control-plane-start) [[ -x "$2/openhouse-control-plane-start" ]] ;;
    openhouse-termux-services-env) [[ -x "$2/_termux-services-env.sh" ]] ;;
    openhouse-start-service-manager) [[ -x "$2/start-service-manager.sh" ]] ;;
    openhouse-repair-control-plane) [[ -x "$2/repair-control-plane.sh" ]] ;;
    openhouse-inspect-control-plane) [[ -x "$2/inspect-control-plane.sh" ]] ;;
    *) return 1 ;;
  esac
}

current_target() { readlink -f "$INSTALL_ROOT/$1/current" 2>/dev/null || true; }

current_valid() {
  local id="$1" version="$2" digest="$3" target schema receipt_version receipt_digest
  target="$(current_target "$id")"
  [[ -n "$target" && -d "$target" && "$target" == "$INSTALL_ROOT/$id/versions/"* ]] || return 1
  [[ -f "$RECEIPTS/$id.json" ]] || return 1
  schema="$(jq -r '.schema // 0' "$RECEIPTS/$id.json" 2>/dev/null || true)"
  [[ "$schema" == 3 || "$schema" == 4 ]] || return 1
  receipt_version="$(jq -r '.version // empty' "$RECEIPTS/$id.json" 2>/dev/null || true)"
  [[ "$receipt_version" == "$version" ]] || return 1
  if [[ "$schema" == 4 ]]; then
    receipt_digest="$(jq -r '.archiveSha256 // empty' "$RECEIPTS/$id.json" 2>/dev/null || true)"
    [[ "$receipt_digest" == "$digest" ]] || return 1
  fi
  resource_required "$id" "$target"
}

write_receipt() {
  local id="$1" version="$2" digest="$3" size="$4" temporary
  temporary="$RECEIPTS/$id.json.tmp.$$"
  jq -n --arg id "$id" --arg version "$version" --arg archiveSha256 "$digest" --argjson archiveSize "$size" \
    --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:4,id:$id,version:$version,archiveSha256:$archiveSha256,archiveSize:$archiveSize,content:"installed",updatedAt:$updatedAt}' >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$RECEIPTS/$id.json"
}

write_installed_set() {
  local set_file="$1" temporary
  temporary="$INSTALLED_SET.tmp.$$"
  jq '{schema:4,id,version,sequence,abi,resources:[.resources[] | {id,version,size,sha256}]}' \
    "$set_file" >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$INSTALLED_SET"
}

refresh_receipts() {
  local set_file="$1" id version archive size digest
  while IFS=$'\t' read -r id version archive size digest; do
    current_valid "$id" "$version" "$digest" \
      || die "installed resource is invalid after content apply: $id@$version"
    write_receipt "$id" "$version" "$digest" "$size"
  done < <(resource_rows "$set_file")
}

build_plan() {
  local set_file="$1" plan="$2" id version archive size digest source status
  : >"$plan"
  while IFS=$'\t' read -r id version archive size digest; do
    safe_value "$id"; safe_value "$version"; safe_value "$archive"
    if [[ "$FORCE_RESOURCE" != all && "$FORCE_RESOURCE" != "$id" ]] && current_valid "$id" "$version" "$digest"; then
      status=skip; source=-
    elif [[ "$COMMAND" == plan ]]; then
      source=-
      status=apply
    else
      source="$(archive_for "$id" "$archive" || true)"
      [[ -n "$source" ]] || die "resource archive is missing: $id@$version ($archive)"
      status=apply
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$version" "$archive" "$size" "$digest" "$status" >>"$plan"
  done < <(resource_rows "$set_file")
}

print_plan() {
  local plan="$1" total changed bytes=0 id version archive size digest status
  total="$(wc -l <"$plan" | tr -d ' ')"
  changed="$(awk -F '\t' '$6 == "apply" {n++} END {print n+0}' "$plan")"
  while IFS=$'\t' read -r id version archive size digest status; do
    [[ "$status" == apply ]] || continue
    [[ "$size" =~ ^[0-9]+$ ]] || die "resource size is invalid: $id"
    bytes=$((bytes + size))
  done <"$plan"
  printf 'target_resources=%s\nchanged=%s\nunchanged=%s\nbytes=%s\n' \
    "$total" "$changed" "$((total - changed))" "$bytes"
  while IFS=$'\t' read -r id version archive size digest status; do
    printf 'resource=%s version=%s action=%s archive=%s size=%s\n' \
      "$id" "$version" "$status" "$archive" "$size"
  done <"$plan"
}

install_script_resource() {
  local id="$1" directory="$2" source target temporary
  case "$id" in
    openhouse-resource-manager) source="$directory/openhouse-resource-manager"; target="$PREFIX/bin/openhouse-resource-manager" ;;
    openhouse-resource-import) source="$directory/openhouse-resource-import"; target="$PREFIX/bin/openhouse-resource-import" ;;
    wuxianpi-setup) source="$directory/wuxianpi-setup"; target="$PREFIX/bin/wuxianpi-setup" ;;
    openhouse-install-runtime-components) source="$directory/50-install-runtime-components.sh"; target="$PREFIX/libexec/openhouse/bootstrap/50-install-runtime-components.sh" ;;
    openhouse-start-smallphone) source="$directory/60-start-smallphone.sh"; target="$PREFIX/libexec/openhouse/bootstrap/60-start-smallphone.sh" ;;
    openhouse-register-component) source="$directory/register-openhouse-component.sh"; target="$PREFIX/libexec/openhouse/bootstrap/register-openhouse-component.sh" ;;
    openhouse-control-plane-start) source="$directory/openhouse-control-plane-start"; target="$PREFIX/bin/openhouse-control-plane-start" ;;
    openhouse-termux-services-env) source="$directory/_termux-services-env.sh"; target="$PREFIX/libexec/openhouse/_termux-services-env.sh" ;;
    openhouse-start-service-manager) source="$directory/start-service-manager.sh"; target="$PREFIX/libexec/openhouse/start-service-manager.sh" ;;
    openhouse-repair-control-plane) source="$directory/repair-control-plane.sh"; target="$PREFIX/libexec/openhouse/repair-control-plane.sh" ;;
    openhouse-inspect-control-plane) source="$directory/inspect-control-plane.sh"; target="$PREFIX/libexec/openhouse/inspect-control-plane.sh" ;;
    *) return 1 ;;
  esac
  mkdir -p "$(dirname "$target")"
  temporary="$target.tmp.$$"
  install -m 700 "$source" "$temporary"
  mv -f "$temporary" "$target"
}

install_handler() {
  local id="$1" directory="$2"
  case "$id" in
    service-manager)
      chmod 755 "$directory/service-manager" "$directory/scripts/"*.sh
      CONFIG_PATH="$HOME/.config/openhouseai/service-manager/config.json" \
        BIND="127.0.0.1:20087" INSTALL_SERVICE=0 \
        "$directory/scripts/install.sh" "$directory/service-manager" ;;
    openhouse-control-plane)
      chmod 700 "$directory/"*.sh
      mkdir -p "$HOME/.local/share/openhouseai/control-plane"
      ln -sfn "$directory" "$HOME/.local/share/openhouseai/control-plane/current"
      install -d "$PREFIX/bin" "$PREFIX/libexec/openhouse"
      install -m 700 "$directory/start-control-plane-termux-native.sh" \
        "$PREFIX/libexec/openhouse/start-service-manager.sh"
      cat >"$PREFIX/bin/openhouse-control-plane-start.tmp.$$" <<'SH'
#!/data/data/com.termux/files/usr/bin/bash
exec "${PREFIX:-/data/data/com.termux/files/usr}/libexec/openhouse/start-service-manager.sh" "$@"
SH
      chmod 700 "$PREFIX/bin/openhouse-control-plane-start.tmp.$$"
      mv -f "$PREFIX/bin/openhouse-control-plane-start.tmp.$$" \
        "$PREFIX/bin/openhouse-control-plane-start" ;;
    openhouse-runtime)
      chmod 755 "$directory/install.sh" "$directory/scripts/"*.sh "$directory/bin/"*
      # The archive root installer also registers a live service. Content
      # convergence only installs the static runtime files.
      "$directory/scripts/install.sh" ;;
    wuyou)
      chmod 755 "$directory/wuyou" "$directory/scripts/"*.sh
      "$directory/scripts/install.sh" ;;
    openhouse-web)
      chmod 755 "$directory/scripts/"*.sh
      "$directory/scripts/install.sh" ;;
    openhouse-resource-manager|openhouse-resource-import|wuxianpi-setup|openhouse-install-runtime-components|openhouse-start-smallphone|openhouse-register-component|openhouse-control-plane-start|openhouse-termux-services-env|openhouse-start-service-manager|openhouse-repair-control-plane|openhouse-inspect-control-plane)
      install_script_resource "$id" "$directory" ;;
    *) die "resource is not allowlisted: $id" ;;
  esac
}

verify_handler() {
  local id="$1" directory="$2"
  resource_required "$id" "$directory"
}

validate_archive() {
  local id="$1" archive="$2" expected_size="$3" actual_size
  actual_size="$(stat -c '%s' "$archive")"
  [[ "$actual_size" == "$expected_size" ]] || die "resource archive size mismatch: $id"
  gzip -t "$archive" || die "resource archive gzip is invalid: $id"
  tar -tzf "$archive" | awk '
    substr($0, 1, 1) == "/" || /(^|\/)\.\.($|\/)/ || /\\/ {bad=1}
    {count++}
    END {if (bad || count == 0 || count > 100000) exit 1}
  ' || die "resource archive path list is unsafe: $id"
  tar -tvzf "$archive" | awk '
    {kind=substr($1,1,1); if (kind != "-" && kind != "d" && kind != "l") bad=1; bytes += $3; count++}
    END {if (bad || count > 100000 || bytes > 1073741824) exit 1}
  ' || die "resource archive entries are unsafe or too large: $id"
}

validate_extracted_links() {
  local root="$1" link target resolved
  while IFS= read -r -d '' link; do
    target="$(readlink "$link")"
    [[ "$target" != /* && "$target" != *'\\'* ]] || die 'resource archive contains an unsafe symbolic link'
    resolved="$(readlink -f "$link" 2>/dev/null || true)"
    [[ -n "$resolved" && "$resolved" == "$root"/* ]] || die 'resource archive symbolic link escapes resource root'
  done < <(find "$root" -type l -print0)
}

rollback() {
  local transaction="$1" id target old backup receipt receipt_backup
  [[ -f "$transaction/previous.tsv" ]] || return 0
  while IFS=$'\t' read -r id target old backup; do
    [[ "$target" == - ]] || { [[ ! -e "$target" ]] || mv "$target" "$transaction/failed-$id"; }
    [[ ! -d "$backup" ]] || mv "$backup" "$target"
    if [[ "$old" == - ]]; then
      rm -f "$INSTALL_ROOT/$id/current"
    else
      ln -sfn "$old" "$INSTALL_ROOT/$id/current"
      install_handler "$id" "$old" || true
    fi
    receipt="$RECEIPTS/$id.json"; receipt_backup="$transaction/receipts/$id.json"
    if [[ -f "$receipt_backup" ]]; then cp "$receipt_backup" "$receipt"; else rm -f "$receipt"; fi
  done < <(tac "$transaction/previous.tsv")
  if [[ -f "$transaction/installed-set.json" ]]; then
    install -m 600 "$transaction/installed-set.json" "$INSTALLED_SET"
  else
    rm -f "$INSTALLED_SET"
  fi
}

apply_content() {
  local set_file="$1" plan="$2" transaction="$3" write_set="${4:-1}" id version archive size digest status source target current old backup staged
  mkdir -p "$transaction/staged" "$transaction/receipts" "$transaction/backups"
  : >"$transaction/previous.tsv"
  [[ ! -f "$INSTALLED_SET" ]] || install -m 600 "$INSTALLED_SET" "$transaction/installed-set.json"
  while IFS=$'\t' read -r id version archive size digest status; do
    [[ "$status" == apply ]] || continue
    source="$(archive_for "$id" "$archive")"
    validate_archive "$id" "$source" "$size"
    staged="$transaction/staged/$id"
    mkdir -p "$staged"
    tar -xzf "$source" -C "$staged" --no-same-owner --no-same-permissions
    validate_extracted_links "$staged"
    resource_required "$id" "$staged" || die "resource archive structure is invalid: $id"
  done <"$plan"
  while IFS=$'\t' read -r id version archive size digest status; do
    [[ "$status" == apply ]] || continue
    target="$INSTALL_ROOT/$id/versions/$version"
    current="$INSTALL_ROOT/$id/current"
    old="$(current_target "$id")"; [[ -n "$old" ]] || old=-
    backup="$transaction/backups/$id"
    mkdir -p "$(dirname "$target")"
    [[ ! -f "$RECEIPTS/$id.json" ]] || cp "$RECEIPTS/$id.json" "$transaction/receipts/$id.json"
    printf '%s\t%s\t%s\t%s\n' "$id" "$target" "$old" "$backup" >>"$transaction/previous.tsv"
    [[ ! -e "$target" ]] || mv "$target" "$backup"
    mv "$transaction/staged/$id" "$target"
    ln -sfn "$target" "$current"
    FAILED_STEP="install:$id"
    printf '%s\n' "$FAILED_STEP" >"$transaction/failed-step"
    install_handler "$id" "$target"
    verify_handler "$id" "$target"
    write_receipt "$id" "$version" "$digest" "$size"
  done <"$plan"
  if [[ "$write_set" == 1 ]]; then
    [[ ! -f "$INSTALLED_SET" ]] || install -m 600 "$INSTALLED_SET" "$PREVIOUS_SET"
    write_installed_set "$set_file"
    refresh_receipts "$set_file"
  fi
}

run_apply() {
  local workspace plan transaction
  [[ -n "$SET_FILE" && -n "$SOURCE_DIR" ]] || die 'apply requires OPENHOUSEAI_RESOURCE_SET_FILE and OPENHOUSEAI_RESOURCE_SOURCE_DIR'
  read_set "$SET_FILE"
  local temp_root="${TMPDIR:-$PREFIX/tmp}"
  mkdir -p "$temp_root"
  workspace="$(mktemp -d "$temp_root/openhouse-resource-plan.XXXXXX")"
  plan="$workspace/plan.tsv"
  build_plan "$SET_FILE" "$plan"
  print_plan "$plan"
  [[ "$COMMAND" == plan || "$COMMAND" == inspect ]] && { rm -rf "$workspace"; return 0; }
  transaction="$TRANSACTIONS/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  CURRENT_TRANSACTION="$transaction"; mkdir -p "$transaction"
  cp "$SET_FILE" "$transaction/resource-set.json"; cp "$plan" "$transaction/plan.tsv"
  set +e
  ( set -e; apply_content "$SET_FILE" "$plan" "$transaction" ) 2>&1 | tee "$transaction/diagnostics.log"
  local code=${PIPESTATUS[0]}
  set -e
  if [[ "$code" -ne 0 ]]; then
    rollback "$transaction" || true
    mkdir -p "$FAILED/$(basename "$transaction")"
    printf 'failedStep=%s\nexitCode=%s\n' \
      "$(cat "$transaction/failed-step" 2>/dev/null || printf unknown)" "$code" >>"$transaction/diagnostics.log"
    cp -a "$transaction/." "$FAILED/$(basename "$transaction")/"
    rm -rf "$workspace" "$transaction"
    die "static content transaction failed; evidence kept in $FAILED/$(basename "$transaction")"
  fi
  rm -rf "$workspace" "$transaction"
  printf 'content=installed\nresource_set=%s\nsequence=%s\n' \
    "$(jq -r '.id + "@" + .version' "$SET_FILE")" "$(jq -r '.sequence' "$SET_FILE")"
}

verify_installed() {
  [[ -f "$INSTALLED_SET" ]] || die 'installed set is missing'
  local failures=0 id version digest target
  while IFS=$'\t' read -r id version digest; do
    target="$(current_target "$id")"
    if [[ -n "$target" ]] && current_valid "$id" "$version" "$digest" && verify_handler "$id" "$target"; then
      printf 'resource=%s status=ok version=%s\n' "$id" "$version"
    else
      printf 'resource=%s status=invalid version=%s\n' "$id" "$version" >&2; failures=$((failures + 1))
    fi
  done < <(jq -r '.resources[] | [.id,.version,.sha256] | @tsv' "$INSTALLED_SET")
  ((failures == 0))
}

inspect_installed() {
  if [[ ! -f "$INSTALLED_SET" ]]; then
    printf 'installed=false\n'
    return 0
  fi
  printf 'installed=true\nresource_set=%s\nversion=%s\nsequence=%s\n' \
    "$(jq -r '.id' "$INSTALLED_SET")" "$(jq -r '.version' "$INSTALLED_SET")" "$(jq -r '.sequence' "$INSTALLED_SET")"
  verify_installed
}

rollback_previous() {
  [[ -f "$PREVIOUS_SET" ]] || die 'previous set is unavailable'
  [[ "$(jq -r '.schema // 0' "$PREVIOUS_SET")" == 4 ]] \
    || die 'legacy previous set cannot be rolled back automatically'
  local id version digest size target current receipt
  while IFS=$'\t' read -r id version digest size; do
    target="$INSTALL_ROOT/$id/versions/$version"
    [[ -d "$target" ]] || die "previous resource version is missing: $id@$version"
    resource_required "$id" "$target" || die "previous resource version is invalid: $id@$version"
  done < <(jq -r '.resources[] | [.id,.version,.sha256,.size] | @tsv' "$PREVIOUS_SET")
  while IFS=$'\t' read -r id version digest size; do
    target="$INSTALL_ROOT/$id/versions/$version"
    current="$INSTALL_ROOT/$id/current"
    ln -sfn "$target" "$current"
    install_handler "$id" "$target"
    write_receipt "$id" "$version" "$digest" "$size"
  done < <(jq -r '.resources[] | [.id,.version,.sha256,.size] | @tsv' "$PREVIOUS_SET")
  install -m 600 "$INSTALLED_SET" "$INSTALLED_SET.rollback.$$"
  install -m 600 "$PREVIOUS_SET" "$INSTALLED_SET"
  mv -f "$INSTALLED_SET.rollback.$$" "$PREVIOUS_SET"
  printf 'content=rolled-back\nsequence=%s\n' "$(jq -r '.sequence' "$INSTALLED_SET")"
}

fetch_market_resources() {
  local set_file="$1" id version archive size digest destination temporary actual_size actual_digest
  read_set "$set_file"
  SOURCE_DIR="$MARKET_CACHE/$(jq -r '.id + "-" + (.sequence | tostring)' "$set_file")"
  mkdir -p "$SOURCE_DIR"
  chmod 700 "$SOURCE_DIR"
  MARKET_ORIGIN="${MARKET_ORIGIN%/}"
  [[ "$MARKET_ORIGIN" == "$OFFICIAL_MARKET_ORIGIN" ]] \
    || die "unsupported market origin: $MARKET_ORIGIN"
  while IFS=$'\t' read -r id version archive size digest; do
    if current_valid "$id" "$version" "$digest"; then
      continue
    fi
    destination="$SOURCE_DIR/$archive"
    if [[ -f "$destination" ]]; then
      actual_size="$(stat -c '%s' "$destination")"
      actual_digest="$(sha256sum "$destination" | awk '{print $1}')"
      if [[ "$actual_size" == "$size" && "$actual_digest" == "$digest" ]]; then
        continue
      fi
    fi
    temporary="$destination.part.$$"
    curl -q -fL --connect-timeout 10 --max-time 600 \
      "$MARKET_ORIGIN/resources-v2/$id/$version/$archive" -o "$temporary" \
      || { rm -f "$temporary"; die "market resource download failed: $id@$version"; }
    actual_size="$(stat -c '%s' "$temporary")"
    actual_digest="$(sha256sum "$temporary" | awk '{print $1}')"
    [[ "$actual_size" == "$size" && "$actual_digest" == "$digest" ]] \
      || { rm -f "$temporary"; die "market resource size or SHA mismatch: $id@$version"; }
    mv -f "$temporary" "$destination"
  done < <(resource_rows "$set_file")
}

run_market() {
  local workspace plan row_plan transaction id version archive size digest status code
  require_market_tools
  [[ -n "$SET_FILE" ]] || die 'market requires --set FILE'
  read_set "$SET_FILE"
  fetch_market_resources "$SET_FILE"
  mkdir -p "${TMPDIR:-$PREFIX/tmp}"
  workspace="$(mktemp -d "${TMPDIR:-$PREFIX/tmp}/openhouse-market-plan.XXXXXX")"
  plan="$workspace/plan.tsv"
  build_plan "$SET_FILE" "$plan"
  print_plan "$plan"

  while IFS=$'\t' read -r id version archive size digest status; do
    [[ "$status" == apply ]] || continue
    row_plan="$workspace/$id.tsv"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$id" "$version" "$archive" "$size" "$digest" "$status" >"$row_plan"
    transaction="$TRANSACTIONS/market-$(date -u +%Y%m%dT%H%M%SZ)-$id-$$"
    CURRENT_TRANSACTION="$transaction"
    mkdir -p "$transaction"
    cp "$SET_FILE" "$transaction/resource-set.json"
    cp "$row_plan" "$transaction/plan.tsv"
    set +e
    ( set -e; apply_content "$SET_FILE" "$row_plan" "$transaction" 0 ) \
      2>&1 | tee "$transaction/diagnostics.log"
    code=${PIPESTATUS[0]}
    set -e
    if [[ "$code" -ne 0 ]]; then
      rollback "$transaction" || true
      mkdir -p "$FAILED/$(basename "$transaction")"
      printf 'failedStep=%s\nexitCode=%s\n' \
        "$(cat "$transaction/failed-step" 2>/dev/null || printf unknown)" "$code" \
        >>"$transaction/diagnostics.log"
      cp -a "$transaction/." "$FAILED/$(basename "$transaction")/"
      rm -rf "$workspace" "$transaction"
      die "market resource install failed: $id@$version; completed resources were retained"
    fi
    rm -rf "$transaction"
    printf 'resource=%s version=%s status=installed\n' "$id" "$version"
  done <"$plan"

  [[ ! -f "$INSTALLED_SET" ]] || install -m 600 "$INSTALLED_SET" "$PREVIOUS_SET"
  write_installed_set "$SET_FILE"
  refresh_receipts "$SET_FILE"
  rm -rf "$workspace"
  printf 'content=installed\nresource_set=%s\nsequence=%s\n' \
    "$(jq -r '.id + "@" + .version' "$SET_FILE")" "$(jq -r '.sequence' "$SET_FILE")"
}

main() {
  require_tools; setup_dirs
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --set) SET_FILE="${2:-}"; shift 2 ;;
      --source) SOURCE_DIR="${2:-}"; shift 2 ;;
      --market-origin) MARKET_ORIGIN="${2:-}"; shift 2 ;;
      --resource) FORCE_RESOURCE="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done
  exec 9>"$LOCK_FILE"; flock -n 9 || die 'another content transaction is running'
  case "$COMMAND" in
    inspect) inspect_installed ;;
    market) run_market ;;
    plan|apply|force) [[ "$COMMAND" != force ]] || FORCE_RESOURCE="${FORCE_RESOURCE:-all}"; run_apply ;;
    verify) verify_installed ;;
    rollback) rollback_previous ;;
    *) die 'usage: openhouse-resource-manager [inspect|plan|apply|market|force|verify|rollback] --set FILE [--source DIR|--market-origin URL]' ;;
  esac
}

main "$@"
