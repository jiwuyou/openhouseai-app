#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

TERMUX_HOME="${HOME:-/data/data/com.termux/files/home}"
TERMUX_PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_HOME="${WUXIANPI_SETUP_HOME:-$TERMUX_HOME/.local/state/wuxianpi-setup}"
SESSION_NAME="wuxianpi-setup"
LOG_FILE="$SETUP_HOME/setup.log"
STATE_FILE="$SETUP_HOME/state.json"
EXIT_FILE="$SETUP_HOME/exit-code"
REQUEST_FILE="$SETUP_HOME/request.json"
MAX_LOG_BYTES="${WUXIANPI_SETUP_MAX_LOG_BYTES:-2097152}"
PI_URL="${WUXIANPI_PI_URL:-http://127.0.0.1:20765}"
SETUP_REGION="auto"
SETUP_TERMUX_REPO="auto"
SETUP_UBUNTU_ROOTFS_MIRROR="auto"
SETUP_UBUNTU_APT_MIRROR="auto"
SETUP_NODE_DIST_MIRROR="auto"
SETUP_NPM_REGISTRY="auto"
SETUP_RUNTIME_ARCHIVE=""
SETUP_RUNTIME_ARCHIVE_EXPLICIT=0
SETUP_RESOURCE_INBOX=""
SETUP_OFFER_ID=""
SETUP_CONNECTION_BRIDGE_ID=""
SETUP_APK_VERSION_CODE="${OPENHOUSEAI_APK_VERSION_CODE:-}"
RESOURCE_MANAGER_ROOT="$TERMUX_HOME/.local/share/openhouseai/resource-manager"
RESOURCE_INSTALL_ROOT="$TERMUX_HOME/.local/share/openhouseai/resources"
ACTIVATION_ROOT="$RESOURCE_MANAGER_ROOT/activation"
CANONICAL_SM_CONFIG="$TERMUX_HOME/.config/openhouseai/service-manager/config.json"
CANONICAL_SM_BIND="127.0.0.1:20087"
CANONICAL_SM_URL="http://127.0.0.1:20087"

log() {
  printf '[WuxianPi Setup] %s\n' "$*"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

json_bool() {
  if "$@"; then printf true; else printf false; fi
}

ensure_state_dir() {
  mkdir -p "$SETUP_HOME"
}

rotate_log() {
  ensure_state_dir
  [ -f "$LOG_FILE" ] || return 0
  local size
  size="$(wc -c < "$LOG_FILE" | tr -d '[:space:]')"
  case "$size" in ''|*[!0-9]*) size=0 ;; esac
  if [ "$size" -ge "$MAX_LOG_BYTES" ]; then
    rm -f "$LOG_FILE.2"
    [ ! -f "$LOG_FILE.1" ] || mv "$LOG_FILE.1" "$LOG_FILE.2"
    mv "$LOG_FILE" "$LOG_FILE.1"
  fi
}

compact_log() {
  [ -f "$LOG_FILE" ] || return 0
  local size
  size="$(wc -c < "$LOG_FILE" | tr -d '[:space:]')"
  case "$size" in ''|*[!0-9]*) size=0 ;; esac
  [ "$size" -le "$MAX_LOG_BYTES" ] || {
    tail -c "$MAX_LOG_BYTES" "$LOG_FILE" > "$LOG_FILE.tmp"
    mv "$LOG_FILE.tmp" "$LOG_FILE"
  }
}

current_resource_dir() {
  local native_root="$TERMUX_HOME/.local/share/wuxianpi/install-resources/current"
  local root="$TERMUX_HOME/.local/share/openhouseai/update-resources"
  if [ -f "$native_root/bundle-manifest.json" ] \
    && [ -f "$native_root/bootstrap/bootstrap.sh" ] \
    && [ -f "$native_root/resources/resource-set.json" ]; then
    printf '%s\n' "$native_root"
    return 0
  fi
  if [ -f "$native_root/.complete" ] \
    && [ -f "$native_root/bootstrap/bootstrap.sh" ] \
    && [ -f "$native_root/product-payloads/manifest.json" ]; then
    printf '%s\n' "$native_root"
    return 0
  fi
  find "$root" -mindepth 2 -maxdepth 2 -type f -name .complete -print 2>/dev/null \
    | sed 's#/.complete$##' \
    | while IFS= read -r directory; do
        [ -f "$directory/bootstrap/bootstrap.sh" ] || continue
        [ -f "$directory/bootstrap/scripts/wuxianpi-setup" ] || continue
        [ -f "$directory/product-payloads/manifest.json" ] || continue
        printf '%s\t%s\n' "$(stat -c %Y "$directory/.complete" 2>/dev/null || printf 0)" "$directory"
      done \
    | sort -rn \
    | awk -F '\t' 'NR == 1 { print $2 }'
}

resource_dir() {
  local configured="${WUXIANPI_RESOURCE_DIR:-}"
  if [ -n "$configured" ] && [ -f "$configured/.complete" ]; then
    printf '%s\n' "$configured"
    return 0
  fi
  current_resource_dir
}

market_bootstrap_file() {
  local root="$TERMUX_PREFIX/libexec/openhouse/bootstrap" required
  for required in \
    bootstrap.sh \
    scripts/20-install-ubuntu.sh \
    scripts/30-update-ubuntu-packages.sh \
    scripts/_ubuntu-mirror-policy.sh \
    scripts/_retry-profile.sh; do
    [[ -x "$root/$required" ]] || return 1
  done
  printf '%s/bootstrap.sh\n' "$root"
}

bootstrap_file() {
  local root
  market_bootstrap_file && return
  root="$(resource_dir)"
  [ -n "$root" ] || return 1
  printf '%s/bootstrap/bootstrap.sh\n' "$root"
}

payload_dir() {
  local root
  root="$(resource_dir)"
  [ -n "$root" ] || return 1
  if [ -f "$root/resources/resource-set.json" ]; then
    printf '%s/resources\n' "$root"
  else
    printf '%s/product-payloads\n' "$root"
  fi
}

runtime_archive_candidates() {
  local root
  [ -n "$SETUP_RUNTIME_ARCHIVE" ] && printf '%s\n' "$SETUP_RUNTIME_ARCHIVE"
  printf '%s/.local/share/wuxianpi/install-resources/runtime-aarch64.tgz\n' "$TERMUX_HOME"
  root="$(resource_dir || true)"
  [ -n "$root" ] && printf '%s/resources/runtime-aarch64.tgz\n' "$root"
  [ -n "$root" ] && printf '%s/product-payloads/runtime-aarch64.tgz\n' "$root"
}

runtime_archive_has_required_members() {
  local archive="$1" member listing
  [ -s "$archive" ] || return 1
  listing="$(tar -tzf "$archive" 2>/dev/null | sed 's#^\./##')" || return 1
  for member in \
    './bin/wuxianpi-node' \
    './bin/wuxianpi-node-start' \
    './layers/wuxianpi-base-' \
    './layers/wuxianpi-runtime-' \
    './layers/wuxianpi-web-' \
    './scripts/install.sh' \
    './scripts/install-release.sh' \
    './scripts/register-service.sh'; do
    if [[ "$member" == './layers/'*'-' ]]; then
      grep -Eq "^${member#./}[^/]+\\.tar\\.zst$" <<<"$listing" || return 1
    else
      grep -Fxq "${member#./}" <<<"$listing" || return 1
    fi
  done
}

resolve_runtime_archive() {
  local candidate
  local -a candidates=()
  local -a rejected=()
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    case " ${candidates[*]} " in
      *" $candidate "*) continue ;;
    esac
    candidates+=("$candidate")
    if [ ! -s "$candidate" ]; then
      rejected+=("$candidate (missing or empty)")
      continue
    fi
    if ! runtime_archive_has_required_members "$candidate"; then
      rejected+=("$candidate (not a valid WuxianPi Runtime archive)")
      continue
    fi
    SETUP_RUNTIME_ARCHIVE="$candidate"
    log "最终选中的 Runtime 路径：$SETUP_RUNTIME_ARCHIVE"
    return 0
  done < <(runtime_archive_candidates)

  log 'Runtime 载荷缺失或校验失败；已检查以下候选路径：'
  for candidate in "${rejected[@]}"; do
    log "  - $candidate"
  done
  if [ "${#candidates[@]}" -eq 0 ]; then
    log '  - (没有可用候选路径)'
  fi
  return 1
}

run_bootstrap() {
  local command="$1"
  shift || true
  local bootstrap payload root
  bootstrap="$(bootstrap_file)" || {
    log '未找到市场 Ubuntu bootstrap 或完整的 APK 版本化资源目录。'
    return 1
  }
  root="$(dirname "$(dirname "$bootstrap")")"
  payload="$(payload_dir || true)"
  env \
    HOME="$TERMUX_HOME" \
    PREFIX="$TERMUX_PREFIX" \
    PATH="$TERMUX_PREFIX/bin:/system/bin" \
    SMALLPHONEAI_ROOT="$root/bootstrap" \
    SMALLPHONEAI_BOOTSTRAP="$bootstrap" \
    SMALLPHONEAI_OFFLINE_PAYLOAD_DIR="$payload" \
    SMALLPHONEAI_BUNDLED_PAYLOAD_ROOT="$payload" \
    SMALLPHONEAI_COMPONENT_SOURCE_MODE=bundle \
    SMALLPHONEAI_SKIP_OPENHOUSE_SYSTEM=1 \
    SMALLPHONEAI_COMPONENT_TARGETS="${SMALLPHONEAI_COMPONENT_TARGETS:-}" \
    SMALLPHONEAI_COMPONENT_ACTION="${SMALLPHONEAI_COMPONENT_ACTION:-}" \
    SMALLPHONEAI_PI_RUNTIME_ARCHIVE="$SETUP_RUNTIME_ARCHIVE" \
    SMALLPHONEAI_REQUIRE_SERVICE_MANAGER_READY="${SMALLPHONEAI_REQUIRE_SERVICE_MANAGER_READY:-0}" \
    SMALLPHONEAI_START_TARGETS="${SMALLPHONEAI_START_TARGETS:-}" \
    SMALLPHONEAI_FORCE_PAYLOAD_REFRESH="${SMALLPHONEAI_FORCE_PAYLOAD_REFRESH:-0}" \
    bash "$bootstrap" "$command" "$@"
}

termux_ready() {
  [ -x "$TERMUX_PREFIX/bin/bash" ] && { [ -x "$TERMUX_PREFIX/bin/pkg" ] || [ -x "$TERMUX_PREFIX/bin/apt" ]; }
}

tmux_ready() {
  [ -x "$TERMUX_PREFIX/bin/tmux" ]
}

service_manager_ready() {
  local service_root="$TERMUX_PREFIX/var/service"
  local status

  [ -x "$TERMUX_PREFIX/bin/service-manager" ] || return 1
  [ -x "$TERMUX_PREFIX/bin/sv" ] || return 1
  [ -x "$service_root/service-manager/run" ] || return 1
  status="$(env SVDIR="$service_root" "$TERMUX_PREFIX/bin/sv" status service-manager 2>/dev/null || true)"
  case "$status" in run:*) ;; *) return 1 ;; esac
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --max-time 3 http://127.0.0.1:20087/api/v1/health >/dev/null 2>&1 \
    || curl -fsS --max-time 3 http://127.0.0.1:20087/ >/dev/null 2>&1
}

service_manager_token() {
  local token config
  token="${SERVICE_MANAGER_TOKEN:-${SMALLPHONE_SERVICE_MANAGER_TOKEN:-}}"
  if [ -n "$token" ]; then
    printf '%s\n' "$token"
    return 0
  fi
  config="$(printf '%s\n' "$TERMUX_HOME/.config/openhouseai/service-manager/config.json")"
  [ -x "$TERMUX_PREFIX/bin/service-manager" ] || return 1
  "$TERMUX_PREFIX/bin/service-manager" token show --config "$config" 2>/dev/null \
    | head -n 1 | tr -d '\r\n'
}

wuxianpi_service_registered() {
  local token body
  token="$(service_manager_token || true)"
  [ -n "$token" ] || return 1
  body="$(curl -fsS --max-time 3 \
    -H "Authorization: Bearer $token" \
    http://127.0.0.1:20087/api/v1/services 2>/dev/null || true)"
  printf '%s' "$body" \
    | grep -Eq '"id"[[:space:]]*:[[:space:]]*"yuanshengwuxianpi"'
}

pi_health_body() {
  local endpoint
  command -v curl >/dev/null 2>&1 || return 1
  endpoint="$(wuxianpi_endpoint_url 2>/dev/null || true)"
  if [ -n "$endpoint" ]; then
    curl -fsS --max-time 3 "${endpoint%/}/health" 2>/dev/null
    return
  fi
  curl -fsS --max-time 3 "$PI_URL/health" 2>/dev/null
}

pi_ready() {
  local body
  body="$(pi_health_body)" || return 1
  printf '%s' "$body" | grep -Fq '"protocol"'
}

pi_port_state() {
  local body
  if body="$(pi_health_body)"; then
    if printf '%s' "$body" | grep -Fq '"protocol"'; then
      printf ready
    else
      printf conflict
    fi
    return 0
  fi
  if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | awk '$4 ~ /:20765$/ { found=1 } END { exit(found ? 0 : 1) }'; then
    printf conflict
  else
    printf free
  fi
}

ubuntu_ready() {
  command -v proot-distro >/dev/null 2>&1 \
    && proot-distro login ubuntu -- true >/dev/null 2>&1
}

session_running() {
  tmux_ready && tmux has-session -t "$SESSION_NAME" 2>/dev/null
}

emit_status() {
  local resource session state exit_code port_state offer_id receipt delivery content activation failure sequence
  local canonical_config canonical_auth sm_health runit registry_file registry_api pi_health
  if [ -z "$SETUP_RESOURCE_INBOX" ] && [ -f "$REQUEST_FILE" ]; then
    load_request "$REQUEST_FILE" >/dev/null 2>&1 || true
  fi
  resource="$(resource_dir || true)"
  if session_running; then session=running; else session=stopped; fi
  state=idle
  [ ! -s "$STATE_FILE" ] || state="$(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' "$STATE_FILE" | head -n 1)"
  [ -n "$state" ] || state=unknown
  exit_code="$(sed -n '1p' "$EXIT_FILE" 2>/dev/null || true)"
  port_state="$(pi_port_state)"
  offer_id="$(offer_id_from_inbox)"
  receipt=''
  [ -z "$offer_id" ] || receipt="$RESOURCE_MANAGER_ROOT/receipts/apk-offers/$offer_id.json"
  delivery=missing; content=missing; activation=pending; failure=''; sequence=0
  if [ -f "$receipt" ]; then
    delivery="$(jq -r '.delivery // "missing"' "$receipt")"
    content="$(jq -r '.content // "missing"' "$receipt")"
    activation="$(jq -r '.activation // "pending"' "$receipt")"
    failure="$(jq -r '.activationFailure // empty' "$receipt")"
    sequence="$(jq -r '.resourceSetSequence // 0' "$receipt")"
  elif [ -f "$RESOURCE_MANAGER_ROOT/installed-set.json" ]; then
    content=installed
    sequence="$(jq -r '.sequence // 0' "$RESOURCE_MANAGER_ROOT/installed-set.json" 2>/dev/null || printf 0)"
  fi
  if [ -s "$CANONICAL_SM_CONFIG" ]; then canonical_config=true; else canonical_config=false; fi
  if service_manager_ready; then sm_health=true; else sm_health=false; fi
  if service_manager_runit_status; then runit=true; else runit=false; fi
  if canonical_service_manager_auth_ready; then canonical_auth=true; else canonical_auth=false; fi
  if [ -f "$TERMUX_HOME/.config/openhouseai/service-manager/services.d/yuanshengwuxianpi.json" ] \
    && [ -f "$TERMUX_HOME/.config/openhouseai/components.d/yuanshengwuxianpi.json" ]; then registry_file=true; else registry_file=false; fi
  if canonical_service_manager_registry_ready; then registry_api=true; else registry_api=false; fi
  if pi_ready; then pi_health=true; else pi_health=false; fi
  jq -nc \
    --arg session "$session" --arg state "$state" --arg piPort20765 "$port_state" \
    --arg resourceDir "$resource" --arg logFile "$LOG_FILE" --arg exitCode "$exit_code" \
    --arg offerId "$offer_id" --arg delivery "$delivery" --arg content "$content" \
    --arg activation "$activation" --arg activationFailure "$failure" \
    --argjson resourceSetSequence "${sequence:-0}" \
    --argjson termuxReady "$(json_bool termux_ready)" \
    --argjson tmuxReady "$(json_bool tmux_ready)" \
    --argjson ubuntuReady "$(json_bool ubuntu_ready)" \
    --argjson canonicalConfigReady "$canonical_config" --argjson serviceManagerHealth "$sm_health" \
    --argjson serviceManagerRunitReady "$runit" --argjson canonicalAuthReady "$canonical_auth" \
    --argjson registryFileReady "$registry_file" --argjson registryApiReady "$registry_api" \
    --argjson wuxianPiHealth "$pi_health" \
    '{ok:true,termuxReady:$termuxReady,tmuxReady:$tmuxReady,session:$session,state:$state,serviceManagerReady:$serviceManagerHealth,piReady:$wuxianPiHealth,piPort20765:$piPort20765,ubuntuReady:$ubuntuReady,resourceDir:$resourceDir,logFile:$logFile,exitCode:$exitCode,offerId:$offerId,resourceSetSequence:$resourceSetSequence,delivery:$delivery,content:$content,activation:$activation,activationFailure:$activationFailure,canonicalConfigReady:$canonicalConfigReady,serviceManagerHealth:$serviceManagerHealth,serviceManagerRunitReady:$serviceManagerRunitReady,canonicalAuthReady:$canonicalAuthReady,serviceListReady:$canonicalAuthReady,registryFileReady:$registryFileReady,registryApiReady:$registryApiReady,wuxianPiHealth:$wuxianPiHealth}'
}

service_manager_runit_status() {
  local service_root="$TERMUX_PREFIX/var/service" status
  [ -x "$service_root/service-manager/run" ] || return 1
  status="$(env SVDIR="$service_root" "$TERMUX_PREFIX/bin/sv" status service-manager 2>/dev/null || true)"
  case "$status" in run:*) return 0 ;; *) return 1 ;; esac
}

canonical_service_manager_auth_ready() {
  [ -s "$CANONICAL_SM_CONFIG" ] || return 1
  authenticated_service_manager_request GET /api/v1/services >/dev/null 2>&1
}

canonical_service_manager_registry_ready() {
  local body
  body="$(authenticated_service_manager_request GET /api/v1/registry/components 2>/dev/null || true)"
  printf '%s' "$body" | grep -Eq '"id"[[:space:]]*:[[:space:]]*"yuanshengwuxianpi"'
}

wuxianpi_endpoint_url() {
  local body
  body="$(authenticated_service_manager_request GET /api/v1/services/yuanshengwuxianpi/endpoints/runtime 2>/dev/null || true)"
  printf '%s' "$body" | jq -r 'select(.name == "runtime" and (.port | type == "number")) | .url // empty' 2>/dev/null
}

wuxianpi_runtime_endpoint_ready() {
  local attempt endpoint
  for attempt in $(seq 1 10); do
    endpoint="$(wuxianpi_endpoint_url)"
    if [ -n "$endpoint" ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

prepare_tmux() {
  termux_ready || {
    log 'Termux bootstrap 尚未完成。'
    return 1
  }
  if tmux_ready; then
    log 'tmux 已安装。'
    return 0
  fi
  local pre_tmux="$SCRIPT_DIR/wuxianpi-pre-tmux.sh"
  [ -f "$pre_tmux" ] || {
    log "缺少 pre-tmux 脚本：$pre_tmux"
    return 1
  }
  "$TERMUX_PREFIX/bin/bash" "$pre_tmux" \
    --region "$SETUP_REGION" \
    --termux-repo "$SETUP_TERMUX_REPO"
  tmux_ready || {
    log 'tmux 安装后仍不可用。'
    return 1
  }
  log 'tmux 已准备完成。'
}

write_state() {
  local state="$1" stage="$2" message="${3:-}"
  ensure_state_dir
  printf '{"state":"%s","stage":"%s","message":"%s","updatedAt":%s}\n' \
    "$(json_escape "$state")" "$(json_escape "$stage")" "$(json_escape "$message")" "$(date +%s)" \
    > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

run_core_install() {
  rotate_log
  exec >> "$LOG_FILE" 2>&1
  set -x
  local resource_import="$TERMUX_PREFIX/bin/openhouse-resource-import"
  [ -x "$resource_import" ] || {
    log "缺少 APK 离线资源导入器：$resource_import"
    return 1
  }
  [ -n "$SETUP_RESOURCE_INBOX" ] || {
    log '缺少 APK 资源 Inbox；请使用 --resource-inbox 指定已发布的总包目录。'
    return 1
  }
  write_state running resource-set '正在收敛 OpenHouse 五个核心资源'
  "$resource_import" "$SETUP_RESOURCE_INBOX"
  write_state completed content-installed 'WuxianPi 五个核心资源已安装；运行激活待单独执行'
}

run_ubuntu_install() {
  rotate_log
  exec >> "$LOG_FILE" 2>&1
  set -x
  write_state running ubuntu '正在安装 Ubuntu'
  run_bootstrap ubuntu
  write_state running ubuntu-packages '正在配置 Ubuntu 软件源和基础包'
  run_bootstrap ubuntu-packages
  write_state completed ubuntu-installed 'Ubuntu 环境已安装'
}

run_install_job() {
  ensure_state_dir
  rm -f "$EXIT_FILE"
  set +e
  ( set -e; run_core_install )
  local code=$?
  set -e
  compact_log
  if [ "$code" -eq 0 ]; then
    printf '0\n' > "$EXIT_FILE"
  else
    printf '%s\n' "$code" > "$EXIT_FILE"
    if ! grep -Fq '"state":"failed"' "$STATE_FILE" 2>/dev/null; then
      write_state failed install "安装任务退出，代码 $code"
    fi
    return "$code"
  fi
}

resolve_apk_version_code() {
  local root value
  value="${SETUP_APK_VERSION_CODE:-${OPENHOUSEAI_APK_VERSION_CODE:-}}"
  case "$value" in
    ''|*[!0-9]*) ;;
    *) printf '%s\n' "$value"; return 0 ;;
  esac
  root="$(resource_dir || true)"
  if [ -n "$root" ] && [ -f "$root/.complete" ]; then
    value="$(sed -n 's/.*"apkVersionCode"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$root/.complete" | head -n 1)"
    case "$value" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$value"; return 0 ;;
    esac
  fi
  printf '126\n'
}

write_request() {
  ensure_state_dir
  printf '{"region":"%s","termuxRepo":"%s","ubuntuRootfsMirror":"%s","ubuntuAptMirror":"%s","nodeDistMirror":"%s","npmRegistry":"%s","runtimeArchive":"%s","resourceInbox":"%s","connectionBridgeId":"%s","apkVersionCode":%s,"updatedAt":%s}\n' \
    "$(json_escape "$SETUP_REGION")" \
    "$(json_escape "$SETUP_TERMUX_REPO")" \
    "$(json_escape "$SETUP_UBUNTU_ROOTFS_MIRROR")" \
    "$(json_escape "$SETUP_UBUNTU_APT_MIRROR")" \
    "$(json_escape "$SETUP_NODE_DIST_MIRROR")" \
    "$(json_escape "$SETUP_NPM_REGISTRY")" \
    "$(json_escape "$SETUP_RUNTIME_ARCHIVE")" \
    "$(json_escape "$SETUP_RESOURCE_INBOX")" \
    "$(json_escape "$SETUP_CONNECTION_BRIDGE_ID")" \
    "$(resolve_apk_version_code)" \
    "$(date +%s)" > "$REQUEST_FILE.tmp"
  mv "$REQUEST_FILE.tmp" "$REQUEST_FILE"
}

request_json_value() {
  local file="$1" key="$2"
  sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" | head -n 1
}

request_json_number() {
  local file="$1" key="$2"
  sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$file" | head -n 1
}

load_request() {
  local file="$1" value
  [ -f "$file" ] || { log "安装请求文件不存在：$file"; return 1; }
  value="$(request_json_value "$file" region)"; [ -z "$value" ] || SETUP_REGION="$value"
  value="$(request_json_value "$file" termuxRepo)"; [ -z "$value" ] || SETUP_TERMUX_REPO="$value"
  value="$(request_json_value "$file" ubuntuRootfsMirror)"; [ -z "$value" ] || SETUP_UBUNTU_ROOTFS_MIRROR="$value"
  value="$(request_json_value "$file" ubuntuAptMirror)"; [ -z "$value" ] || SETUP_UBUNTU_APT_MIRROR="$value"
  value="$(request_json_value "$file" nodeDistMirror)"; [ -z "$value" ] || SETUP_NODE_DIST_MIRROR="$value"
  value="$(request_json_value "$file" npmRegistry)"; [ -z "$value" ] || SETUP_NPM_REGISTRY="$value"
  value="$(request_json_value "$file" runtimeArchive)"
  if [ "$SETUP_RUNTIME_ARCHIVE_EXPLICIT" -eq 0 ] && [ -n "$value" ]; then
    SETUP_RUNTIME_ARCHIVE="$value"
  fi
  value="$(request_json_value "$file" resourceInbox)"
  [ -z "$value" ] || SETUP_RESOURCE_INBOX="$value"
  value="$(request_json_value "$file" connectionBridgeId)"
  [ -z "$value" ] || SETUP_CONNECTION_BRIDGE_ID="$value"
  value="$(request_json_number "$file" apkVersionCode)"
  [ -z "$value" ] || SETUP_APK_VERSION_CODE="$value"
}

apply_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --request) load_request "${2:-}"; shift 2 ;;
      --region) SETUP_REGION="${2:-}"; shift 2 ;;
      --termux-repo) SETUP_TERMUX_REPO="${2:-}"; shift 2 ;;
      --ubuntu-rootfs-mirror) SETUP_UBUNTU_ROOTFS_MIRROR="${2:-}"; shift 2 ;;
      --ubuntu-apt-mirror) SETUP_UBUNTU_APT_MIRROR="${2:-}"; shift 2 ;;
      --node-dist-mirror) SETUP_NODE_DIST_MIRROR="${2:-}"; shift 2 ;;
      --npm-registry) SETUP_NPM_REGISTRY="${2:-}"; shift 2 ;;
      --runtime-archive)
        [ -n "${2:-}" ] || { log '缺少 --runtime-archive 的文件路径。'; return 2; }
        SETUP_RUNTIME_ARCHIVE="${2:-}"
        SETUP_RUNTIME_ARCHIVE_EXPLICIT=1
        shift 2
        ;;
      --resource-inbox)
        [ -n "${2:-}" ] || { log '缺少 --resource-inbox 的目录路径。'; return 2; }
        SETUP_RESOURCE_INBOX="${2:-}"
        shift 2
        ;;
      --offer-id)
        [ -n "${2:-}" ] || { log '缺少 --offer-id。'; return 2; }
        SETUP_OFFER_ID="${2:-}"
        shift 2
        ;;
      --connection-bridge-id)
        [ -n "${2:-}" ] || { log '缺少 --connection-bridge-id。'; return 2; }
        SETUP_CONNECTION_BRIDGE_ID="${2:-}"
        shift 2
        ;;
      *) log "未知安装参数：$1"; return 2 ;;
    esac
  done
  case "$SETUP_REGION" in
    auto|cn|global) ;;
    *) log "不支持的地区参数：$SETUP_REGION"; return 2 ;;
  esac

  case "$SETUP_REGION" in
    cn) export OPENHOUSE_RETRY_MODE=cn SMALLPHONEAI_RETRY_MODE=cn ;;
    *) export OPENHOUSE_RETRY_MODE=normal SMALLPHONEAI_RETRY_MODE=normal ;;
  esac
  if [ "$SETUP_TERMUX_REPO" != auto ]; then
    export OPENHOUSEAI_TERMUX_MAIN_REPO="$SETUP_TERMUX_REPO"
    export SMALLPHONEAI_TERMUX_MAIN_REPO="$SETUP_TERMUX_REPO"
  fi
  if [ "$SETUP_UBUNTU_ROOTFS_MIRROR" != auto ]; then
    export OPENHOUSEAI_UBUNTU_ROOTFS_URL="$SETUP_UBUNTU_ROOTFS_MIRROR"
    export SMALLPHONEAI_UBUNTU_ROOTFS_URL="$SETUP_UBUNTU_ROOTFS_MIRROR"
  fi
  if [ "$SETUP_UBUNTU_APT_MIRROR" != auto ]; then
    export OPENHOUSEAI_UBUNTU_APT_MIRROR="$SETUP_UBUNTU_APT_MIRROR"
    export SMALLPHONEAI_UBUNTU_APT_MIRROR="$SETUP_UBUNTU_APT_MIRROR"
  fi
  if [ "$SETUP_NODE_DIST_MIRROR" != auto ]; then
    export OPENHOUSEAI_NODE_DIST_BASE="$SETUP_NODE_DIST_MIRROR"
    export SMALLPHONEAI_NODE_DIST_BASE="$SETUP_NODE_DIST_MIRROR"
  fi
  if [ "$SETUP_NPM_REGISTRY" != auto ]; then
    export NPM_REGISTRY="$SETUP_NPM_REGISTRY"
    export NPM_CONFIG_REGISTRY="$SETUP_NPM_REGISTRY"
  fi
}

install_runtime_script() {
  local source="$1"
  local target="$2"
  if [ -e "$target" ] && [ "$source" -ef "$target" ]; then
    chmod 755 "$target"
    return 0
  fi
  install -m 755 "$source" "$target"
}

start_install() {
  tmux_ready || {
    log 'tmux 尚未准备完成；请先执行 prepare-tmux。'
    return 1
  }
  resolve_runtime_archive || return 1
  install_runtime_script "$SCRIPT_DIR/wuxianpi-setup" "$TERMUX_PREFIX/bin/wuxianpi-setup"
  install_runtime_script "$SCRIPT_DIR/wuxianpi-pre-tmux.sh" "$TERMUX_PREFIX/bin/wuxianpi-pre-tmux.sh"
  write_request
  write_state running start '安装任务已在持久 Termux 会话中启动'
  run_install_job
}

verify_core() {
  local failed=0
  termux_ready || { log 'FAIL termux'; failed=1; }
  tmux_ready || { log 'FAIL tmux'; failed=1; }
  [ "$(jq -r '.status // empty' "$ACTIVATION_ROOT/status.json" 2>/dev/null || true)" = ready ] \
    || { log 'FAIL activation'; failed=1; }
  # Recompute live activation facts instead of trusting the compact activation
  # marker.  Older markers intentionally contain only status/failure metadata,
  # and a stale marker must never make verification pass after a crash.
  canonical_service_manager_auth_ready \
    || { log 'FAIL canonical auth'; failed=1; }
  canonical_service_manager_registry_ready \
    || { log 'FAIL registry api'; failed=1; }
  pi_ready \
    || { log 'FAIL yuanshengwuxianpi health'; failed=1; }
  [ "$failed" -eq 0 ] || return 1
  log 'Termux、tmux、service-manager 和 WuxianPi 均已就绪。'
}

activation_process_count() {
  local count
  count="$(pgrep -f '(^|/)service-manager[[:space:]]+serve([[:space:]]|$)' 2>/dev/null | wc -l | tr -d '[:space:]' || true)"
  case "$count" in ''|*[!0-9]*) printf '0\n' ;; *) printf '%s\n' "$count" ;; esac
}

activation_instance_arguments_state() {
  local pid count=0 matched=0 args
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    count=$((count + 1))
    args="$(tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    if printf '%s\n' "$args" | grep -Fqx -- "$CANONICAL_SM_CONFIG" \
      && printf '%s\n' "$args" | grep -Fqx -- "$CANONICAL_SM_BIND"; then
      matched=$((matched + 1))
    fi
  done < <(pgrep -f '(^|/)service-manager[[:space:]]+serve([[:space:]]|$)' 2>/dev/null || true)
  if [ "$count" -eq 1 ] && [ "$matched" -eq 1 ]; then printf matched; else printf mismatched; fi
}

activation_json() {
  local status="$1" failure="${2:-}" offer_id="${3:-}" output="$ACTIVATION_ROOT/status.json" temporary
  local canonical_config legacy_config runsvdir runit_service process_count instance_arguments
  local health_20087 canonical_auth service_list registry_file registry_api wuxianpi_health service_body
  mkdir -p "$ACTIVATION_ROOT"
  temporary="$output.tmp.$$"
  if [ -s "$CANONICAL_SM_CONFIG" ]; then canonical_config=ok; else canonical_config=missing; fi
  if [ -s "$TERMUX_HOME/.config/service-manager/config.json" ]; then legacy_config=present; else legacy_config=absent; fi
  if pgrep -f 'runsvdir.*(/var/service|/service)' >/dev/null 2>&1; then runsvdir=running; else runsvdir=stopped; fi
  if [ ! -x "$TERMUX_PREFIX/var/service/service-manager/run" ]; then
    runit_service=missing
  elif service_manager_runit_status; then
    runit_service=running
  else
    runit_service=stopped
  fi
  process_count="$(activation_process_count)"
  instance_arguments="$(activation_instance_arguments_state)"
  if curl -q -fsS --max-time 3 "$CANONICAL_SM_URL/api/v1/health" >/dev/null 2>&1; then health_20087=ok; else health_20087=failed; fi
  service_body=''
  if service_body="$(authenticated_service_manager_request GET /api/v1/services 2>/dev/null)"; then
    canonical_auth=ok
    if [ -n "$service_body" ]; then service_list=ok; else service_list=empty; fi
  else
    canonical_auth=failed
    service_list=failed
  fi
  if [ -f "$TERMUX_HOME/.config/openhouseai/service-manager/services.d/yuanshengwuxianpi.json" ] \
    && [ -f "$TERMUX_HOME/.config/openhouseai/components.d/yuanshengwuxianpi.json" ]; then registry_file=ok; else registry_file=missing; fi
  if canonical_service_manager_registry_ready; then registry_api=ok; else registry_api=failed; fi
  if pi_ready; then wuxianpi_health=ok; else wuxianpi_health=failed; fi
  jq -n --arg status "$status" --arg failure "$failure" --arg activationFailure "$failure" --arg offerId "$offer_id" \
    --arg canonicalConfig "$canonical_config" --arg legacyConfig "$legacy_config" \
    --arg runsvdir "$runsvdir" --arg runitService "$runit_service" \
    --argjson processCount "$process_count" --arg instanceArguments "$instance_arguments" \
    --arg health20087 "$health_20087" --arg canonicalAuth "$canonical_auth" \
    --arg serviceList "$service_list" --arg registryFile "$registry_file" \
    --arg registryApi "$registry_api" --arg wuxianpiHealth "$wuxianpi_health" \
    --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:2,status:$status,failure:$failure,activationFailure:$activationFailure,offerId:$offerId,canonicalConfig:$canonicalConfig,legacyConfig:$legacyConfig,runsvdir:$runsvdir,runitService:$runitService,processCount:$processCount,instanceArguments:$instanceArguments,health20087:$health20087,canonicalAuth:$canonicalAuth,serviceList:$serviceList,registryFile:$registryFile,registryApi:$registryApi,wuxianpiHealth:$wuxianpiHealth,updatedAt:$updatedAt}' >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$output"
}

offer_id_from_inbox() {
  [ -z "$SETUP_OFFER_ID" ] || { printf '%s\n' "$SETUP_OFFER_ID"; return 0; }
  [ -n "$SETUP_RESOURCE_INBOX" ] || return 0
  basename "$SETUP_RESOURCE_INBOX"
}

update_offer_activation() {
  local state="$1" failure="${2:-}" offer_id receipt temporary
  offer_id="$(offer_id_from_inbox)"
  [ -n "$offer_id" ] || return 0
  receipt="$RESOURCE_MANAGER_ROOT/receipts/apk-offers/$offer_id.json"
  [ -f "$receipt" ] || return 0
  temporary="$receipt.tmp.$$"
  jq --arg activation "$state" --arg failure "$failure" \
    --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
      .activation = $activation |
      .activationFailure = (if $failure == "" then null else $failure end) |
      .status = (if $activation == "ready" then "ready-to-complete" else "pending" end) |
      .updatedAt = $updatedAt
    ' "$receipt" >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$receipt"
}

activation_fail() {
  local reason="$1" offer_id
  offer_id="$(offer_id_from_inbox)"
  activation_json failed "$reason" "$offer_id"
  update_offer_activation failed "$reason"
  log "activation=failed activationFailure=$reason"
  return 1
}

ensure_canonical_service_manager_config() {
  mkdir -p "$(dirname "$CANONICAL_SM_CONFIG")"
  chmod 700 "$(dirname "$CANONICAL_SM_CONFIG")"
  if [ ! -s "$CANONICAL_SM_CONFIG" ]; then
    jq -n \
      --arg listen_addr "$CANONICAL_SM_BIND" \
      --arg data_dir "$TERMUX_HOME/.config/openhouseai/service-manager/data" \
      --arg service_registry_dir "$TERMUX_HOME/.config/openhouseai/service-manager/services.d" \
      --arg openhouse_registry_source_dir "$TERMUX_HOME/.config/openhouseai" \
      --arg openhouse_registry_target_dir "$TERMUX_HOME/.local/share/openhouseai/registry" \
      '{listen_addr:$listen_addr,data_dir:$data_dir,service_registry_dir:$service_registry_dir,openhouse_registry_source_dir:$openhouse_registry_source_dir,openhouse_registry_target_dir:$openhouse_registry_target_dir,auth_token:"",log_level:"info",store:{type:"json",path:""}}' \
      >"$CANONICAL_SM_CONFIG"
  fi
  if [ -z "$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')" ]; then
    service-manager token rotate --config "$CANONICAL_SM_CONFIG" >/dev/null
  fi
  chmod 600 "$CANONICAL_SM_CONFIG"
  [ -n "$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')" ]
}

register_installed_resources() {
  local id script token spec_dir spec
  token="$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')"
  [ -n "$token" ] || return 1
  for id in openhouse-runtime wuyou openhouse-web; do
    script="$RESOURCE_INSTALL_ROOT/$id/current/scripts/register-service.sh"
    [ -x "$script" ] || { log "activation resource registration script missing: $id"; return 1; }
    if [ "$id" = openhouse-runtime ]; then
      spec_dir="$(mktemp -d "${TMPDIR:-$TERMUX_PREFIX/tmp}/wuxianpi-service-spec.XXXXXX")"
      spec="$spec_dir/yuanshengwuxianpi.json"
      jq -n \
        --arg home "$TERMUX_HOME" \
        --arg prefix "$TERMUX_PREFIX" \
        '{
          name:"yuanshengwuxianpi",
          description:"WuxianPi Web and Node Runtime",
          provider:"termux-process",
          command:["sh","-lc","wuxianpi-node-start & child=$!; trap '\''kill -TERM $child 2>/dev/null; wait $child 2>/dev/null || true'\'' TERM INT HUP; wait $child"],
          working_dir:($home + "/workspace"),
          env:{
            HOME:$home,
            PATH:($home + "/.local/bin:" + $prefix + "/bin:/system/bin"),
            PI_CODING_AGENT_DIR:($home + "/.pi/agent"),
            OPENHOUSE_PI_LISTEN:"127.0.0.1:{{port:runtime}}",
            OPENHOUSE_PI_RUNTIME_ORIGIN:"http://127.0.0.1:{{port:runtime}}",
            OPENHOUSE_AIONUI_ORIGIN:"http://127.0.0.1:25808/",
            WUXIANPI_WEB_ROOT:($home + "/.local/share/wuxianpi/web")
          },
          runtime:{strategy:"termux-process",runtime:"termux",home:$home},
          ports:[{name:"runtime",host:"127.0.0.1",preferred:20765,dynamic:true,pool:"local-web",protocol:"tcp",envVar:"OPENHOUSE_PI_PORT",endpoint:{scheme:"http",path:"/"}}],
          restart:{mode:"on-failure",max_retries:5},
          health:[{type:"http",url:"http://127.0.0.1:{{port:runtime}}/health",interval:"15s",timeout:"3s"}],
          enabled:true,
          residentByDefault:false,
          tags:["wuxianpi","agent","openhouse-component:yuanshengwuxianpi"]
        }' >"$spec"
      if ! "$script" --spec "$spec"; then
        rm -rf "$spec_dir"
        return 1
      fi
      rm -rf "$spec_dir"
      continue
    fi
    SERVICE_MANAGER_TOKEN="$token" \
      SERVICE_MANAGER_URL="$CANONICAL_SM_URL" \
      SERVICE_MANAGER_CONFIG_PATH="$CANONICAL_SM_CONFIG" \
      SMALLPHONEAI_SERVICE_MANAGER_CONFIG_PATH="$CANONICAL_SM_CONFIG" \
      "$script"
  done
}

register_openhouse_component() {
  local directory target temporary service_spec payload
  directory="$TERMUX_HOME/.config/openhouseai/components.d"
  target="$directory/yuanshengwuxianpi.json"
  mkdir -p "$directory"
  chmod 700 "$directory"
  temporary="$target.tmp.$$"
  cat >"$temporary" <<'JSON'
{
  "schemaVersion": 1,
  "id": "yuanshengwuxianpi",
  "title": "WuxianPi AI",
  "description": "WuxianPi 本地救援 AI",
  "kind": "app",
  "enabled": true,
  "shellMenu": {
    "visible": true,
    "section": "ai",
    "order": 80,
    "title": "WuxianPi AI",
    "subtitle": "本地救援 AI",
    "entry": {"type": "webview", "url": "http://127.0.0.1:20765/"},
    "controlEntry": {"type": "service-control", "serviceNames": ["yuanshengwuxianpi"], "serviceRefs": ["service-manager://services/yuanshengwuxianpi"]},
    "desktop": {"visible": true, "pinned": true, "order": 80, "icon": "brain"}
  },
  "smallphoneApp": {
    "visible": true,
    "section": "ai",
    "order": 80,
    "icon": "brain",
    "entry": {"type": "webview", "url": "http://127.0.0.1:20765/"},
    "controlEntry": {"type": "service-control", "serviceNames": ["yuanshengwuxianpi"], "serviceRefs": ["service-manager://services/yuanshengwuxianpi"]}
  },
  "serviceManager": {"required": true, "services": [{"name": "yuanshengwuxianpi", "title": "WuxianPi AI", "role": "web", "port": 20765, "url": "http://127.0.0.1:20765/", "serviceRef": "service-manager://services/yuanshengwuxianpi", "health": {"type": "http", "url": "http://127.0.0.1:20765/health"}, "controls": ["status", "start", "stop", "restart", "logs"]}]},
  "ai": {
    "visible": true,
    "summary": "WuxianPi 本地救援 AI Web UI，运行于 yuanshengwuxianpi。",
    "intents": [
      {"name": "open", "target": "smallphoneApp.entry"},
      {"name": "control", "target": "smallphoneApp.controlEntry"}
    ]
  }
}
JSON
  chmod 600 "$temporary"
  mv -f "$temporary" "$target"
  service_spec="$TERMUX_HOME/.config/openhouseai/service-manager/services.d/yuanshengwuxianpi.json"
  [ -s "$service_spec" ] || return 1
  payload="$directory/.yuanshengwuxianpi.apply.$$"
  jq -n --slurpfile component "$target" --slurpfile service "$service_spec" \
    '{component:$component[0],services:[{id:"yuanshengwuxianpi",service:$service[0]}]}' >"$payload"
  authenticated_service_manager_request POST /api/v1/registry/apply "$payload" >/dev/null || {
    rm -f "$payload"
    return 1
  }
  rm -f "$payload"
  authenticated_service_manager_request POST /api/v1/registry/sync >/dev/null
}

authenticated_service_manager_request() {
  local method="$1" path="$2" body_file="${3:-}" token auth_dir auth_file result
  token="$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')"
  [ -n "$token" ] || return 1
  auth_dir="$(mktemp -d "${TMPDIR:-$TERMUX_PREFIX/tmp}/wuxianpi-activation-auth.XXXXXX")"
  auth_file="$auth_dir/curl.conf"
  chmod 700 "$auth_dir"
  printf 'header = "Authorization: Bearer %s"\n' "$(printf '%s' "$token" | sed 's/\\/\\\\/g; s/"/\\"/g')" >"$auth_file"
  chmod 600 "$auth_file"
  set +e
  if [ -n "$body_file" ]; then
    curl -q -fsS --connect-timeout 3 --max-time 15 --config "$auth_file" \
      -H 'Content-Type: application/json' -X "$method" --data-binary "@$body_file" "$CANONICAL_SM_URL$path"
  else
    curl -q -fsS --connect-timeout 3 --max-time 15 --config "$auth_file" \
      -X "$method" "$CANONICAL_SM_URL$path"
  fi
  result=$?
  set -e
  rm -rf "$auth_dir"
  return "$result"
}

wait_wuxianpi_health() {
  local attempt=1 endpoint
  while [ "$attempt" -le 30 ]; do
    endpoint="$(wuxianpi_endpoint_url)"
    if [ -n "$endpoint" ] \
      && curl -q -fsS --connect-timeout 2 --max-time 3 "${endpoint%/}/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wuxianpi_service_state() {
  local body
  body="$(authenticated_service_manager_request GET /api/v1/services/yuanshengwuxianpi/status 2>/dev/null || true)"
  printf '%s' "$body" | jq -r '(.state // .status // .service.state // empty)' 2>/dev/null
}

ensure_wuxianpi_started() {
  local state
  if pi_ready; then
    log 'WuxianPi 已健康运行，跳过重复 start。'
    return 0
  fi
  state="$(wuxianpi_service_state || true)"
  case "$state" in
    running|starting)
      log "WuxianPi service-manager 状态为 $state，等待现有实例健康。"
      wait_wuxianpi_health
      return
      ;;
  esac
  authenticated_service_manager_request POST /api/v1/services/yuanshengwuxianpi/start >/dev/null \
    || return 1
  wait_wuxianpi_health
}

activate_runtime() {
  local control_script services offer_id token
  mkdir -p "$ACTIVATION_ROOT"
  chmod 700 "$ACTIVATION_ROOT"
  exec 8>"$ACTIVATION_ROOT/activation.lock"
  flock -n 8 || { log '已有运行激活任务正在执行。'; return 1; }
  offer_id="$(offer_id_from_inbox)"
  activation_json running '' "$offer_id"
  update_offer_activation pending ''

  command -v service-manager >/dev/null 2>&1 \
    || activation_fail service_manager_binary_missing
  ensure_canonical_service_manager_config \
    || activation_fail canonical_config_invalid

  service-manager install-service --config "$CANONICAL_SM_CONFIG" --bind "$CANONICAL_SM_BIND" \
    || activation_fail runit_install_failed
  control_script="$TERMUX_PREFIX/bin/openhouse-control-plane-start"
  [ -x "$control_script" ] || activation_fail control_plane_entry_missing
  "$control_script" || activation_fail service_manager_start_failed

  curl -q -fsS --connect-timeout 3 --max-time 8 "$CANONICAL_SM_URL/api/v1/health" >/dev/null \
    || activation_fail health_20087_failed
  services="$(authenticated_service_manager_request GET /api/v1/services)" \
    || activation_fail canonical_auth_failed
  [ -n "$services" ] || activation_fail service_list_empty

  register_installed_resources || activation_fail registry_file_failed
  token="$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')"
  [ -n "$token" ] || activation_fail canonical_auth_failed
  register_openhouse_component || activation_fail component_registration_failed
  services="$(authenticated_service_manager_request GET /api/v1/services)" \
    || activation_fail service_list_after_registry_failed
  printf '%s' "$services" | grep -Eq '"id"[[:space:]]*:[[:space:]]*"yuanshengwuxianpi"' \
    || activation_fail wuxianpi_registration_missing
  canonical_service_manager_registry_ready \
    || activation_fail component_registry_missing
  ensure_wuxianpi_started || activation_fail wuxianpi_start_failed
  wuxianpi_runtime_endpoint_ready || activation_fail wuxianpi_endpoint_failed
  wait_wuxianpi_health || activation_fail wuxianpi_health_failed

  if publish_android_connection; then
    log 'connection=saved bridge=openhouse-host-bridge'
  else
    log 'connection=failed；核心运行环境已经激活，可单独重试连接上报。'
  fi
  activation_json ready '' "$offer_id"
  update_offer_activation ready ''
  log 'activation=ready health20087=ok canonicalAuth=ok runit=ok instance=unique registry=ok wuxianpiHealth=ok'
}

connection_info() {
  local token listen url
  [ -s "$CANONICAL_SM_CONFIG" ] || { printf 'canonical service-manager config is missing\n' >&2; return 1; }
  token="$(service-manager token show --config "$CANONICAL_SM_CONFIG" 2>/dev/null | head -n 1 | tr -d '\r\n')"
  [ -n "$token" ] || { printf 'canonical service-manager token is missing\n' >&2; return 1; }
  listen="$(jq -r '.listen_addr // .listenAddr // .bind // "127.0.0.1:20087"' "$CANONICAL_SM_CONFIG")"
  case "$listen" in
    http://*|https://*) url="${listen%/}" ;;
    0.0.0.0:*) url="http://127.0.0.1:${listen#0.0.0.0:}" ;;
    :*) url="http://127.0.0.1$listen" ;;
    *) url="http://$listen" ;;
  esac
  jq -cn --arg serviceManagerBaseUrl "$url" --arg token "$token" \
    --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,serviceManagerBaseUrl:$serviceManagerBaseUrl,token:$token,updatedAt:$updatedAt}'
}

publish_android_connection() {
  local candidate health identity connection port port_json
  [ -n "$SETUP_CONNECTION_BRIDGE_ID" ] || {
    log '未提供 OpenHouse connection bridge 标识，跳过 Android 连接上报。'
    return 1
  }
  connection="$(connection_info)" || return 1
  port="$(printf '%s' "$connection" | jq -r '.serviceManagerBaseUrl | capture(":(?<port>[0-9]+)$").port // empty' 2>/dev/null || true)"
  [ -n "$port" ] || return 1
  port_json="$(jq -cn --argjson port "$port" '{port:$port}')"
  for candidate in \
    http://127.0.0.1:20771 \
    http://127.0.0.1:20772 \
    http://127.0.0.1:20773 \
    http://127.0.0.1:20774 \
    http://127.0.0.1:20775; do
    health="$(curl -q -fsS --connect-timeout 1 --max-time 2 "$candidate/v1/health" 2>/dev/null || true)"
    printf '%s' "$health" | jq -e '.ok == true and .service == "openhouse-host-bridge"' >/dev/null 2>&1 \
      || continue
    identity="$(curl -q -fsS --connect-timeout 1 --max-time 2 "$candidate/v1/identity" 2>/dev/null || true)"
    printf '%s' "$identity" | jq -e --arg bridgeId "$SETUP_CONNECTION_BRIDGE_ID" \
      '.service == "openhouse-host-bridge" and .bridgeId == $bridgeId' >/dev/null 2>&1 \
      || continue
    curl -q -fsS --connect-timeout 2 --max-time 5 \
      -X PUT -H 'Content-Type: application/json' --data-binary "$connection" \
      "$candidate/v1/write/private/service-manager.connection" >/dev/null \
      || continue
    curl -q -fsS --connect-timeout 2 --max-time 5 \
      -X PUT -H 'Content-Type: application/json' --data-binary "$port_json" \
      "$candidate/v1/write/public/service-manager.port" >/dev/null \
      || true
    return 0
  done
  return 1
}

repair() {
  rm -f "$EXIT_FILE"
  start_install
}

usage() {
  cat <<'EOF'
Usage: wuxianpi-setup <inspect|prepare-tmux|install|activate|register-component|ubuntu|connection-info|status|verify|repair> [options]

Options:
  --region auto|cn|global
  --request FILE
  --termux-repo URL|auto
  --ubuntu-rootfs-mirror URL|auto
  --ubuntu-apt-mirror URL|auto
  --node-dist-mirror URL|auto
  --npm-registry URL|auto
  --runtime-archive FILE
  --resource-inbox DIRECTORY
  --offer-id ID
  --connection-bridge-id ID
EOF
}

command="${1:-}"
shift || true
case "$command" in
  inspect|status) emit_status ;;
  prepare-tmux) apply_options "$@"; prepare_tmux ;;
  install) apply_options "$@"; start_install ;;
  activate)
    [ ! -s "$REQUEST_FILE" ] || load_request "$REQUEST_FILE"
    apply_options "$@"
    activate_runtime
    ;;
  register-component) apply_options "$@"; register_installed_resources; register_openhouse_component ;;
  ubuntu) apply_options "$@"; run_ubuntu_install ;;
  connection-info) connection_info ;;
  verify) verify_core; emit_status ;;
  repair) apply_options "$@"; repair ;;
  *) usage; exit 2 ;;
esac
