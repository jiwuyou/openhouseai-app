#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
MANAGER_ROOT="${OPENHOUSEAI_RESOURCE_MANAGER_ROOT:-$HOME/.local/share/openhouseai/resource-manager}"
INBOX_ROOT="$HOME/.local/share/openhouseai/apk-resource-inbox"
TRANSACTIONS="$MANAGER_ROOT/transactions"
FAILED="$MANAGER_ROOT/failed"
RECEIPTS="$MANAGER_ROOT/receipts/apk-offers"
BUNDLE_NAME="openhouse-install-bundle.tar"
IMPORT_TRANSACTION=""
FAILED_STEP="initializing"

log() { printf '[resource-import] %s\n' "$*"; }
die() { printf '[resource-import] ERROR: %s\n' "$*" >&2; exit 1; }

require_tools() {
  local tool
  for tool in jq tar gzip find awk readlink stat; do
    command -v "$tool" >/dev/null 2>&1 || die "missing required command: $tool"
  done
  [[ -x "$PREFIX/bin/bash" ]] || die "missing Termux bash: $PREFIX/bin/bash"
}

canonical_inbox() {
  local requested="$1" root resolved
  root="$(readlink -f "$INBOX_ROOT")"
  resolved="$(readlink -f "$requested")"
  [[ -n "$root" && -n "$resolved" ]] || die 'unable to resolve APK resource inbox'
  case "$resolved" in "$root"/*) printf '%s\n' "$resolved" ;; *) die 'inbox is outside APK resource root' ;; esac
}

validate_tar() {
  local archive="$1"
  tar -tf "$archive" | awk '
    substr($0, 1, 1) == "/" || /(^|\/)\.\.($|\/)/ || /\\/ {bad=1}
    {count++}
    END {if (bad || count == 0) exit 1}
  ' || die 'bundle contains unsafe or empty paths'
  tar -tvf "$archive" | awk '
    {kind=substr($1,1,1); if (kind != "-" && kind != "d") bad=1; bytes += $3; count++}
    END {if (bad || count > 100000 || bytes > 2147483648) exit 1}
  ' || die 'bundle contains links, devices, or unsupported entries'
}

validate_manifest() {
  local root="$1" manifest set
  manifest="$root/bundle-manifest.json"
  set="$root/resources/resource-set.json"
  [[ -f "$manifest" && -f "$set" ]] || die 'bundle manifest or resource set is missing'
  jq -e '
    .schema == 2 and .id == "openhouse-install-bundle" and
    (.bundleId | type == "string" and length > 0) and
    (.apkVersionCode | type == "number" and . > 0) and
    .resourceSet.id == "openhouse-core-stack" and .resourceSet.abi == "arm64-v8a"
  ' "$manifest" >/dev/null || die 'bundle manifest is invalid'
  jq -e '
    .schema == 2 and .id == "openhouse-core-stack" and .abi == "arm64-v8a" and
    (([.resources[].id] | sort) == ["openhouse-control-plane","openhouse-runtime","openhouse-web","service-manager","wuyou"] or
     ([.resources[].id] | sort) == ["openhouse-control-plane-start","openhouse-inspect-control-plane","openhouse-install-runtime-components","openhouse-register-component","openhouse-repair-control-plane","openhouse-resource-import","openhouse-resource-manager","openhouse-runtime","openhouse-start-service-manager","openhouse-start-smallphone","openhouse-termux-services-env","openhouse-web","service-manager","wuxianpi-setup","wuyou"]) and
    ([.resources[].id] | length) == ([.resources[].id] | unique | length) and
    all(.resources[]; (.archive | type == "string" and test("^[A-Za-z0-9._-]+\\.tgz$")) and (.size | type == "number" and . > 0))
  ' "$set" >/dev/null || die 'resource set is invalid'
  jq -e --slurpfile set "$set" '.resourceSet == $set[0]' "$manifest" >/dev/null \
    || die 'bundle manifest and resource set differ'
  while IFS=$'\t' read -r id archive size; do
    [[ -f "$root/resources/$archive" && ! -L "$root/resources/$archive" ]] \
      || die "resource archive is missing: $id"
    [[ "$(stat -c '%s' "$root/resources/$archive")" == "$size" ]] \
      || die "resource archive size is invalid: $id"
    gzip -t "$root/resources/$archive" || die "resource archive is not valid gzip: $id"
    tar -tzf "$root/resources/$archive" >/dev/null || die "resource archive cannot be listed: $id"
  done < <(jq -r '.resources[] | [.id,.archive,.size] | @tsv' "$set")
  for required in \
    bootstrap/bootstrap.sh \
    bootstrap/scripts/wuxianpi-setup \
    bootstrap/scripts/openhouse-resource-import \
    bootstrap/scripts/openhouse-resource-manager; do
    [[ -f "$root/$required" ]] || die "bundle is missing $required"
  done
}

write_offer_receipt() {
  local offer_id="$1" manifest="$2" content="$3" activation="$4" target temporary
  target="$RECEIPTS/$offer_id.json"
  temporary="$target.tmp.$$"
  jq -n \
    --arg offerId "$offer_id" \
    --arg bundleId "$(jq -r '.bundleId' "$manifest")" \
    --arg resourceSetVersion "$(jq -r '.resourceSet.version' "$manifest")" \
    --argjson resourceSetSequence "$(jq -r '.resourceSet.sequence' "$manifest")" \
    --arg delivery ready --arg content "$content" --arg activation "$activation" \
    --arg updatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:3,offerId:$offerId,bundleId:$bundleId,resourceSetVersion:$resourceSetVersion,resourceSetSequence:$resourceSetSequence,delivery:$delivery,content:$content,activation:$activation,status:"pending",updatedAt:$updatedAt}' >"$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$target"
}

failed_snapshot() {
  local transaction="$1" message="$2" destination
  destination="$FAILED/$(basename "$transaction")"
  mkdir -p "$destination"
  cp -a "$transaction/." "$destination/"
  printf 'phase=content\nfailedStep=%s\nmessage=%s\n' "$FAILED_STEP" "$message" >"$destination/diagnostics.log"
  chmod 600 "$destination/diagnostics.log"
  log "failed transaction preserved: $destination"
}

cleanup() {
  local status="$1"
  [[ -z "$IMPORT_TRANSACTION" || ! -d "$IMPORT_TRANSACTION" ]] && return "$status"
  if [[ "$status" -eq 0 ]]; then
    rm -rf "$IMPORT_TRANSACTION"
  else
    failed_snapshot "$IMPORT_TRANSACTION" 'APK content import failed'
  fi
  IMPORT_TRANSACTION=''
  return "$status"
}

main() {
  require_tools
  [[ $# -eq 1 ]] || die 'usage: openhouse-resource-import INBOX_DIRECTORY'
  mkdir -p "$MANAGER_ROOT" "$TRANSACTIONS" "$FAILED" "$RECEIPTS"
  chmod 700 "$MANAGER_ROOT" "$TRANSACTIONS" "$FAILED" "$RECEIPTS"
  local inbox ready bundle offer_id transaction extracted manifest installed
  inbox="$(canonical_inbox "$1")"
  ready="$inbox/.ready"; bundle="$inbox/$BUNDLE_NAME"; offer_id="$(basename "$inbox")"
  [[ "$offer_id" =~ ^[A-Za-z0-9._-]+$ ]] || die 'offerId directory name is invalid'
  [[ -f "$ready" && ! -L "$ready" && ! -s "$ready" ]] || die 'APK resource bundle is not ready'
  [[ -f "$bundle" && ! -L "$bundle" && -s "$bundle" ]] || die 'APK resource bundle is missing'
  if [[ -f "$RECEIPTS/$offer_id.json" ]] &&
     [[ "$(jq -r '.schema // 0' "$RECEIPTS/$offer_id.json" 2>/dev/null || true)" == 3 ]] &&
     [[ "$(jq -r '.content // empty' "$RECEIPTS/$offer_id.json" 2>/dev/null || true)" == installed ]]; then
    log "content already installed; activation remains independent: $offer_id"
    exit 0
  fi
  validate_tar "$bundle"
  transaction="$TRANSACTIONS/apk-offer-$offer_id-$$"
  IMPORT_TRANSACTION="$transaction"
  mkdir -p "$transaction/bundle"
  trap 'cleanup $?' EXIT
  FAILED_STEP=extract-bundle
  tar -xf "$bundle" -C "$transaction/bundle" --no-same-owner --no-same-permissions
  extracted="$transaction/bundle"; manifest="$extracted/bundle-manifest.json"
  FAILED_STEP=validate-bundle
  validate_manifest "$extracted"
  [[ "$offer_id" == *-"$(jq -r '.apkVersionCode' "$manifest")"-"$(jq -r '.resourceSet.sequence' "$manifest")" ]] \
    || die 'offerId does not match bundle APK version and resource sequence'
  FAILED_STEP=install-bootstrap
  install -m 700 "$extracted/bootstrap/scripts/openhouse-resource-manager" "$PREFIX/bin/openhouse-resource-manager"
  install -m 700 "$extracted/bootstrap/scripts/openhouse-resource-import" "$PREFIX/bin/openhouse-resource-import"
  write_offer_receipt "$offer_id" "$manifest" pending pending
  FAILED_STEP=install-content
  OPENHOUSEAI_RESOURCE_SET_FILE="$extracted/resources/resource-set.json" \
  OPENHOUSEAI_RESOURCE_SOURCE_DIR="$extracted/resources" \
    "$PREFIX/bin/bash" "$PREFIX/bin/openhouse-resource-manager" apply
  write_offer_receipt "$offer_id" "$manifest" installed pending
  cleanup 0; trap - EXIT
  log "content installed; activation pending: $offer_id"
}

main "$@"
