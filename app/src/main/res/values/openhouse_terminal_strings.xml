<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="openhouse_terminal_tutorial_skip">跳过</string>
    <string name="openhouse_terminal_tutorial_next">下一步</string>
    <string name="openhouse_terminal_tutorial_start_using">开始使用</string>

    <string name="openhouse_terminal_tutorial_intro_title">终端教学</string>
    <string name="openhouse_terminal_tutorial_intro_body">这里是 OpenHouseAI 的终端。你可以直接输入命令，也可以用底部工具栏快速补全常用按键和 AI 命令。</string>
    <string name="openhouse_terminal_tutorial_sessions_title">多终端侧边栏</string>
    <string name="openhouse_terminal_tutorial_sessions_body">左侧侧边栏用于管理多个终端会话。这里可以新建会话、切换会话，或长按创建命名会话。</string>
    <string name="openhouse_terminal_tutorial_base_keys_title">基础按键</string>
    <string name="openhouse_terminal_tutorial_base_keys_body">底部工具栏前两排保留基础 extra keys：Esc、Tab、Ctrl、Alt、方向键、Home、End、Page Up 和 Page Down。</string>
    <string name="openhouse_terminal_tutorial_ai_keys_title">AI 快捷键</string>
    <string name="openhouse_terminal_tutorial_ai_keys_body" tools:ignore="TypographyDashes">第三排是 OpenHouseAI 默认 AI 快捷键：claude、reasonix、codex、oc 和 --continue。点击命令名会先输入命令和一个空格。</string>
    <string name="openhouse_terminal_tutorial_continue_title">继续对话</string>
    <string name="openhouse_terminal_tutorial_continue_body" tools:ignore="TypographyDashes">要继续 Claude 会话，可以依次点击 claude 和 --continue，终端中会组成 claude --continue。其他 Agent 也可以用同样方式组合。</string>
    <string name="openhouse_terminal_tutorial_full_commands_title">完整继续命令</string>
    <string name="openhouse_terminal_tutorial_full_commands_body" tools:ignore="TypographyDashes">滑到下一页工具栏可直接输入完整继续命令：claude --continue、codex --continue、reasonix --continue 和 oc --continue。</string>
    <string name="openhouse_terminal_tutorial_custom_keys_title">自定义快捷键</string>
    <string name="openhouse_terminal_tutorial_custom_keys_body">检测到你已经在 termux.properties 中配置了 extra-keys。OpenHouseAI 没有覆盖这些自定义键，因此这里只显示你的自定义工具栏。</string>
</resources>
