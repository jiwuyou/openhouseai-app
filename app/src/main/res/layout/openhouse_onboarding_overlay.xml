<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/openhouse_onboarding_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/openhouse_onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/openhouse_onboarding_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/openhouse_onboarding_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/openhouse_onboarding_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/openhouse_onboarding_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/openhouse_onboarding_kicker"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:textColor="#155F43"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/openhouse_onboarding_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/openhouse_onboarding_icon"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#1E6F52"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/openhouse_onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:textColor="#17211C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/openhouse_onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#5F6C65"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/openhouse_onboarding_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/openhouse_onboarding_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/openhouse_onboarding_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/openhouse_onboarding_top_divider"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openhouse_onboarding_previous"
                    android:layout_width="48dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&lt;"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/openhouse_onboarding_step_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#65716A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openhouse_onboarding_next"
                    android:layout_width="48dp"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&gt;"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/openhouse_onboarding_skip_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/openhouse_onboarding_warning_panel"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/openhouse_onboarding_skip_risk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#8F372A"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openhouse_onboarding_skip"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="0dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
