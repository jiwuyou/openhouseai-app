<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smallphoneHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@color/panel"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/smallphone_host_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/smallphoneStatusPill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/smallphone_host_status_checking"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonSmallphoneTopMenu"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_host_menu"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_host_menu_short"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonSmallphoneTopMaintenance"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_host_maintenance"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_host_maintenance_short"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonSmallphoneTopTerminal"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_host_terminal"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_host_terminal_short"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSmallphoneBrowserBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_browser_back"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_browser_back"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/buttonSmallphoneBrowserForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_browser_forward"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_browser_forward"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/buttonSmallphoneBrowserHome"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_browser_home"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_browser_home"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/smallphoneBrowserAddress"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/one_click_item_bg"
                android:ellipsize="end"
                android:hint="@string/smallphone_browser_address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonSmallphoneBrowserGo"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_browser_go"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_browser_go"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonSmallphoneBrowserRefresh"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/one_click_item_bg"
                android:contentDescription="@string/smallphone_browser_refresh"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/smallphone_browser_refresh"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/smallphoneWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/smallphoneHostPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/smallphoneHostHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smallphone_host_checking_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/smallphoneHostDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/smallphone_host_checking_detail"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttonSmallphonePrimary"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/smallphone_host_refresh"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonSmallphoneStart"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/smallphone_host_start"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/buttonSmallphoneRepair"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/smallphone_host_repair"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonSmallphoneMaintenance"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/smallphone_host_maintenance"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/buttonSmallphoneTerminal"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/smallphone_host_terminal"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonSmallphoneExternal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/smallphone_host_open_external"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/smallphone_host_health_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/smallphoneStatusServiceManager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/smallphoneStatusSmallPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/smallphoneStatusCcConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/smallphoneStatusCore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
