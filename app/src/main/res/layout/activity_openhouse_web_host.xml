<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/openhouseWebHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <WebView
        android:id="@+id/openhouseWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/openhouseWebFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/openhouseWebStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/openhouse_web_host_checking"
                android:textColor="@color/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/openhouseWebDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/openhouse_web_host_checking_detail"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonOpenHouseWebRetry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/openhouse_web_host_retry"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/buttonOpenHouseNativeRecovery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/openhouse_web_host_open_recovery"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/buttonOpenHouseTerminal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/openhouse_web_host_open_terminal"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
