<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/openhouseDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/panel"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/buttonOpenDrawer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/openhouse_action_menu"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonCopyCurrent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/openhouse_action_copy"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonOpenCurrentBrowser"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.35"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/openhouse_action_open_browser"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonOpenCurrentControl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/openhouse_action_control"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonRefreshCurrent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/openhouse_action_refresh"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/openhousePageTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/openhouse_home_title"
                android:visibility="gone" />

            <TextView
                android:id="@+id/openhousePageSubtitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/openhouse_home_subtitle"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/openhousePageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/openhouseScrollContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/openhouseContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </ScrollView>

            <FrameLayout
                android:id="@+id/openhouseEmbeddedContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/openhouseNav"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/openhouse_drawer_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/openhouse_drawer_subtitle"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonCloseDrawer"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/one_click_item_bg"
                android:minWidth="0dp"
                android:text="@string/openhouse_action_close"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/openhouseHomeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/openhouse_home_status_default"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonSetCurrentHome"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/openhouse_action_set_current_home"
            android:textAllCaps="false" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/openhouse_section_frequent"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/rowNavSmallPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonNavSmallPhone"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/openhouse_nav_smallphone"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/buttonNavSmallPhoneControl"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="@string/openhouse_action_control"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNavPiAgent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonNavPiAgent"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/openhouse_nav_pi_agent"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/buttonNavPiAgentControl"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="@string/openhouse_action_control"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNavAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonNavAi"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/openhouse_nav_ai"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/buttonNavAiControl"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="@string/openhouse_action_control"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowNavControlledBrowser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonNavControlledBrowser"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/openhouse_nav_controlled_browser"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/buttonNavControlledBrowserControl"
                        android:layout_width="68dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:text="@string/openhouse_action_control"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/openhouseDynamicQuickNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/openhouse_section_all"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/buttonNavServiceControl"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_service_control"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavHome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_home"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavManual"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_manual"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavUsageTutorial"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_usage_tutorial"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:id="@+id/openhouseDynamicNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/openhouse_section_maintenance"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/buttonNavPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_permissions"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavAbout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_about"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavTerminalGuide"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_terminal_guide"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_shortcuts"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavRepair"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_repair"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavLogs"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_logs"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/buttonNavAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/openhouse_nav_advanced"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/buttonNavTerminal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/openhouse_nav_terminal"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
