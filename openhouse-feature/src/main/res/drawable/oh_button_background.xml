<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oh_accent_soft" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/oh_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oh_panel" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/oh_border" />
        </shape>
    </item>
</selector>
