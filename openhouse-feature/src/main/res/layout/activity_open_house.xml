<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oh_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oh_surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/oh_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/oh_panel"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/oh_open_drawer"
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_sidebar"
                android:textAllCaps="false"
                android:textColor="@color/oh_text" />

            <LinearLayout
                android:id="@+id/oh_title_group"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/oh_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/oh_desktop"
                    android:textColor="@color/oh_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/oh_setup_attention"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/oh_attention"
                    android:textSize="11sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <Button
                android:id="@+id/oh_top_desktop"
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_desktop"
                android:textAllCaps="false"
                android:textColor="@color/oh_text" />

            <ImageButton
                android:id="@+id/oh_top_open_browser"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:contentDescription="@string/oh_open_modes"
                android:minWidth="0dp"
                android:padding="10dp"
                android:src="@drawable/oh_ic_window"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/oh_top_page_actions"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:contentDescription="@string/oh_page_actions_content_description"
                android:minWidth="0dp"
                android:padding="10dp"
                android:src="@drawable/oh_ic_page_actions"
                android:visibility="gone" />

            <Button
                android:id="@+id/oh_top_return_small_app"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_return_to_small_app"
                android:textAllCaps="false"
                android:textColor="@color/oh_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/oh_top_close_page"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_close_page"
                android:textAllCaps="false"
                android:textColor="@color/oh_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/oh_top_collapse"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_collapse"
                android:textAllCaps="false"
                android:textColor="@color/oh_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/oh_top_control"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_control"
                android:textAllCaps="false"
                android:textColor="@color/oh_text"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/oh_done_editing"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="完成"
                android:textAllCaps="false"
                android:textColor="@color/oh_text"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/oh_page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/oh_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/oh_top_bar_bubble"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|end"
                android:layout_margin="14dp"
                android:background="@drawable/oh_floating_chrome_background"
                android:contentDescription="@string/oh_expand_toolbar"
                android:elevation="8dp"
                android:padding="13dp"
                android:src="@drawable/oh_ic_menu"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/oh_navigation_drawer"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/oh_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/oh_app_name"
                    android:textColor="@color/oh_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/oh_edition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/oh_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/oh_close_drawer"
                android:layout_width="58dp"
                android:layout_height="42dp"
                android:background="@drawable/oh_button_background"
                android:minWidth="0dp"
                android:text="@string/oh_close"
                android:textAllCaps="false" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/oh_nav_desktop"
                    style="@style/OhDrawerButton"
                    android:text="@string/oh_desktop" />

                <Button
                    android:id="@+id/oh_set_current_home"
                    style="@style/OhDrawerButton"
                    android:text="@string/oh_set_current_home" />

                <LinearLayout
                    android:id="@+id/oh_workspace_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/oh_system"
                    android:textColor="@color/oh_text_secondary"
                    android:textSize="12sp" />

                <Button android:id="@+id/oh_nav_terminal" style="@style/OhDrawerButton" android:text="@string/oh_terminal" />
                <Button android:id="@+id/oh_nav_files" style="@style/OhDrawerButton" android:text="@string/oh_files" />
                <Button android:id="@+id/oh_nav_service" style="@style/OhDrawerButton" android:text="@string/oh_service_control" />
                <Button android:id="@+id/oh_nav_settings" style="@style/OhDrawerButton" android:text="@string/oh_settings" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/view_page_refresh_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
