<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:id="@+id/workspace_item_status"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />

    <Button
        android:id="@+id/workspace_item_button"
        style="@style/OhDrawerButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_weight="1"
        android:minWidth="0dp" />

    <ImageButton
        android:id="@+id/workspace_item_pin"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/oh_button_background"
        android:contentDescription="置顶应用"
        android:padding="9dp"
        android:src="@drawable/oh_ic_pin" />

    <ImageButton
        android:id="@+id/workspace_item_power"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/oh_button_background"
        android:contentDescription="服务开关"
        android:padding="9dp"
        android:src="@drawable/oh_ic_power"
        android:visibility="gone" />
</LinearLayout>
