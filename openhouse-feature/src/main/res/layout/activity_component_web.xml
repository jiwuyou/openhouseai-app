<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oh_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/oh_panel"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/oh_component_web_desktop"
            android:layout_width="64dp"
            android:layout_height="42dp"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_desktop"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/oh_component_web_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/oh_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/oh_component_web_close"
            android:layout_width="58dp"
            android:layout_height="42dp"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_close"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/oh_component_web_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/oh_panel"
        android:ellipsize="middle"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/oh_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/oh_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <Button
            android:id="@+id/oh_component_web_control"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_service_control"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/oh_component_web_maintenance"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_maintenance"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/oh_component_web_refresh"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_refresh"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/oh_component_web_copy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/oh_button_background"
            android:minWidth="0dp"
            android:text="@string/oh_copy_address"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/oh_component_web_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
