{
  "schemaVersion": 1,
  "id": "wuxianpi.first-install.install",
  "title": "初始化 WuxianPi",
  "executionPolicy": {
    "beforePersistentTermux": "execute_termux_command",
    "afterPersistentTermux": "termux_exec_command",
    "longRunningCommands": "termux_exec_command",
    "serviceLifecycle": "service-manager"
  },
  "steps": [
    {
      "id": "inspect",
      "kind": "tool",
      "tool": "inspect_wuxianpi_setup",
      "description": "检查宿主、Termux、命令权限和核心安装状态。SAF 不属于首次安装前置。"
    },
    {
      "id": "prepare-host",
      "kind": "tool",
      "tool": "prepare_runtime_host",
      "description": "准备 Termux bootstrap 和宿主命令通道；已完成时跳过。"
    },
    {
      "id": "run-command",
      "kind": "tool",
      "tool": "request_termux_run_command_permission",
      "when": "runtimeHost.externalTermux",
      "description": "仅检查 RUN_COMMAND Android 权限。未授权时显示延迟卡片并暂停；只有用户点击后才可打开权限页。"
    },
    {
      "id": "configure-external-apps",
      "kind": "tool",
      "tool": "configure_termux_external_apps",
      "when": "runtimeHost.externalTermux",
      "description": "显示三行 Termux 命令卡片。用户必须在 Termux 执行 mkdir、allow-external-apps 和 termux-reload-settings 后返回。不得使用 SAF 写配置。"
    },
    {
      "id": "reload-termux-settings",
      "kind": "user-action",
      "when": "runtimeHost.externalTermux",
      "description": "等待用户明确在 Termux 中执行完三行配置命令（包括 termux-reload-settings）并返回。打开 Termux 不等于配置已生效。"
    },
    {
      "id": "verify-run-command",
      "kind": "tool",
      "tool": "verify_termux_run_command",
      "when": "runtimeHost.externalTermux",
      "description": "仅在用户确认执行三行命令后运行无副作用探针。探针失败时停止，不投递资源。"
    },
    {
      "id": "persistent-terminal",
      "kind": "tool",
      "tool": "prepare_persistent_termux",
      "description": "第一段基础环境：仅安装 tmux 和 libncursesw，创建并验证持久 tmux 会话。"
    },
    {
      "id": "initialize-termux-base",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "set -eu; pkg update -y; pkg upgrade -y; pkg install -y bash jq curl tar gzip zstd coreutils findutils gawk util-linux procps tmux termux-services proot-distro nodejs ca-certificates; for command in jq curl tar gzip tmux sv service-daemon proot-distro node flock; do command -v \"$command\" >/dev/null || { printf 'missing Termux command: %s\\n' \"$command\" >&2; exit 1; }; done; mkdir -p \"$HOME/workspace\" \"$HOME/.local/share/openhouseai\" \"$HOME/.local/share/wuxianpi\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-termux-base",
        "yield_time_ms": 1000
      },
      "description": "第二段基础环境在 tmux 内完成。所有依赖和工作目录验证成功前，禁止获取 APK 资源。"
    },
    {
      "id": "stage-setup",
      "kind": "tool",
      "tool": "start_wuxianpi_setup",
      "description": "基础环境完成后才开放 APK 的本机 HTTP 总包，并返回由 Termux 下载、发布 .ready 和导入五资源的命令。"
    },
    {
      "id": "run-setup",
      "kind": "tool-from-result",
      "tool": "termux_exec_command",
      "sourceStep": "stage-setup",
      "description": "Termux 下载单一 canonical TAR，安装五个核心资源。投递和运行激活是独立阶段。"
    },
    {
      "id": "verify-content",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": ["资源导入仍在运行"]
      },
      "description": "仅等待 delivery=ready 和 content=installed，不等待 Ubuntu，也不要求运行激活。"
    },
    {
      "id": "activate-runtime",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "set -eu; \"$PREFIX/bin/wuxianpi-setup\" activate --request \"$HOME/.local/state/wuxianpi-setup/request.json\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-runtime-activation",
        "yield_time_ms": 1000
      },
      "description": "独立激活 service-manager 和 WuxianPi；必须验证带 Token 的服务列表。失败不回滚已安装资源。"
    },
    {
      "id": "verify-activation",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": ["activation=pending", "service-manager 20087 暂不可达", "registry 同步仍在进行"]
      },
      "description": "要求 activation=ready、canonicalAuthReady、serviceListReady、registryFileReady、registryApiReady 和 wuxianPiHealth 全部为 true。"
    },
    {
      "id": "store-service-manager-connection",
      "kind": "tool",
      "tool": "store_service_manager_connection",
      "description": "读取 canonical 端口和 Token，保存到 Android 私有存储，并把连接信息交给当前维修对话。"
    },
    {
      "id": "complete-resource-offer",
      "kind": "tool",
      "tool": "complete_apk_resource_offer",
      "description": "核心资源和运行激活均通过后，标记当前 APK offer 已完成；Ubuntu 不参与该标记。"
    },
    {
      "id": "install-ubuntu",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "set -eu; \"$PREFIX/bin/wuxianpi-setup\" ubuntu --request \"$HOME/.local/state/wuxianpi-setup/request.json\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-ubuntu",
        "yield_time_ms": 1000
      },
      "description": "最后安装 Ubuntu rootfs 和基础包。失败时保留全部核心运行环境，并提供单独重试。"
    },
    {
      "id": "verify-ubuntu",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": ["Ubuntu 安装仍在运行"]
      },
      "description": "汇总 Ubuntu 后置阶段；Ubuntu 失败不得将已经完成的核心安装改写为失败。"
    }
  ]
}
