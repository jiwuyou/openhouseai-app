{
  "schemaVersion": 1,
  "id": "wuxianpi.first-install.install",
  "title": "初始化 WuxianPi",
  "executionPolicy": {
    "beforePersistentTermux": "execute_termux_command",
    "afterPersistentTermux": "termux_exec_command",
    "longRunningCommands": "termux_exec_command",
    "serviceLifecycle": "service-manager"
  },
  "steps": [
    {
      "id": "inspect",
      "kind": "tool",
      "tool": "inspect_wuxianpi_setup",
      "description": "检查宿主类型、Termux、权限、APK 离线资源和现有资源集合状态。"
    },
    {
      "id": "prepare-host",
      "kind": "tool",
      "tool": "prepare_runtime_host",
      "description": "准备 Termux bootstrap 和宿主命令通道；已完成时跳过。"
    },
    {
      "id": "termux-home",
      "kind": "tool",
      "tool": "request_termux_home_access",
      "when": "runtimeHost.externalTermux && !permissions.termuxHomeWorkspace",
      "description": "显示用户点击后才跳转的 SAF 授权卡片，并确认工作区已绑定到 Termux Home。"
    },
    {
      "id": "run-command",
      "kind": "tool",
      "tool": "request_termux_run_command_permission",
      "when": "runtimeHost.externalTermux",
      "description": "只获取外部 Termux RUN_COMMAND Android 权限；此时不得执行命令探针。"
    },
    {
      "id": "configure-external-apps",
      "kind": "tool",
      "tool": "configure_termux_external_apps",
      "when": "runtimeHost.externalTermux",
      "description": "通过已授权 SAF 读取并规范 $HOME/.termux/termux.properties，使其仅保留 allow-external-apps = true；写后重新读取验证。"
    },
    {
      "id": "reload-termux-settings",
      "kind": "user-action",
      "when": "runtimeHost.externalTermux",
      "description": "暂停工作流：请打开 Termux，在终端执行 termux-reload-settings，执行完成后返回维修助手继续。"
    },
    {
      "id": "verify-run-command",
      "kind": "tool",
      "tool": "verify_termux_run_command",
      "when": "runtimeHost.externalTermux",
      "description": "仅在用户完成 termux-reload-settings 后执行无副作用 RUN_COMMAND 探针。"
    },
    {
      "id": "persistent-terminal",
      "kind": "tool",
      "tool": "prepare_persistent_termux",
      "description": "安装 tmux、curl、jq、tar、gzip 和 flock 所需的最小 Termux 基础能力。"
    },
    {
      "id": "read-control-plane-entry",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/openhouse-control-plane-start"
      },
      "description": "读取 Android 与 Termux 之间唯一稳定的运行中枢入口。"
    },
    {
      "id": "read-service-manager-start",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/start-service-manager.sh"
      },
      "description": "读取独立的 Termux service-manager 启动实现。"
    },
    {
      "id": "prepare-control-plane-script-stage",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "mkdir -p \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install/control-plane\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-control-plane-entry",
        "yield_time_ms": 1000
      },
      "description": "准备固定启动脚本的写入暂存目录。"
    },
    {
      "id": "write-control-plane-entry",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-control-plane-entry",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/wuxianpi/plugins/wuxianpi.first-install/control-plane/openhouse-control-plane-start",
        "content": "{{steps.read-control-plane-entry.content}}"
      },
      "description": "暂存固定入口。"
    },
    {
      "id": "write-service-manager-start",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-service-manager-start",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/wuxianpi/plugins/wuxianpi.first-install/control-plane/start-service-manager.sh",
        "content": "{{steps.read-service-manager-start.content}}"
      },
      "description": "暂存 Termux 启动实现。"
    },
    {
      "id": "install-control-plane-entry",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "set -eu; stage=\"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install/control-plane\"; install -d \"$PREFIX/bin\" \"$PREFIX/libexec/openhouse\"; install -m 700 \"$stage/openhouse-control-plane-start\" \"$PREFIX/bin/openhouse-control-plane-start\"; install -m 700 \"$stage/start-service-manager.sh\" \"$PREFIX/libexec/openhouse/start-service-manager.sh\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-control-plane-entry",
        "yield_time_ms": 1000
      },
      "description": "原子替换两个固定脚本；此步骤不读取资源集合、token 或 service-manager 配置。"
    },
    {
      "id": "stage-setup",
      "kind": "tool",
      "tool": "start_wuxianpi_setup",
      "description": "将 APK 单一离线 TAR 发布到 Termux Inbox，并返回执行本地导入、五资源事务安装和 Ubuntu 安装的命令。"
    },
    {
      "id": "run-setup-native",
      "kind": "tool-from-result",
      "tool": "termux_exec_command",
      "sourceStep": "stage-setup",
      "when": "runtimeHost.externalTermux",
      "description": "Native 使用 stage-setup 返回的原始命令导入 APK 离线总包；全程不依赖 SAF rename 或在线资源插件。"
    },
    {
      "id": "run-setup-embedded",
      "kind": "tool-from-result",
      "tool": "termux_exec_command",
      "sourceStep": "stage-setup",
      "when": "!runtimeHost.externalTermux",
      "description": "All-in-One 使用 stage-setup 返回的命令导入同一份 canonical TAR。"
    },
    {
      "id": "verify-content",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": [
          "资源导入仍在运行",
          "Ubuntu 安装仍在运行"
        ]
      },
      "description": "仅等待 delivery=ready、content=installed 和 Ubuntu 就绪；运行激活尚未开始。"
    },
    {
      "id": "read-openhouse-registration-script",
      "kind": "tool",
      "tool": "read_rescue_plugin_document",
      "arguments": {
        "pluginId": "wuxianpi.first-install",
        "path": "scripts/register-openhouse-component.sh"
      },
      "description": "读取 yuanshengwuxianpi 桌面组件注册脚本。"
    },
    {
      "id": "prepare-openhouse-registration-directory",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "mkdir -p \"$HOME/.local/share/wuxianpi/plugins/wuxianpi.first-install\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-openhouse-registration-prepare",
        "yield_time_ms": 1000
      },
      "description": "准备首次安装插件持久目录。"
    },
    {
      "id": "write-openhouse-registration-script",
      "kind": "tool-from-result",
      "tool": "write_file",
      "sourceStep": "read-openhouse-registration-script",
      "arguments": {
        "environment": "repo:termux-home",
        "path": ".local/share/wuxianpi/plugins/wuxianpi.first-install/register-openhouse-component.sh",
        "content": "{{steps.read-openhouse-registration-script.content}}"
      },
      "description": "写入当前版本的桌面组件注册脚本。"
    },
    {
      "id": "activate-runtime",
      "kind": "tool",
      "tool": "termux_exec_command",
      "arguments": {
        "command": "\"$PREFIX/bin/wuxianpi-setup\" activate --request \"$HOME/.local/state/wuxianpi-setup/request.json\"",
        "working_directory": "$HOME",
        "session_name": "wuxianpi-runtime-activation",
        "yield_time_ms": 1000
      },
      "description": "独立、可重试地创建 canonical 配置、安装 runit、启动 service-manager、注册资源、验证带 token 服务列表和 WuxianPi health；失败绝不回滚 content。"
    },
    {
      "id": "verify-activation",
      "kind": "poll-tool",
      "tool": "get_wuxianpi_setup_status",
      "retryPolicy": {
        "maxAttempts": 10,
        "delayMs": 3000,
        "retryWhen": [
          "activation=pending",
          "service-manager 20087 暂不可达",
          "registry 同步仍在进行"
        ]
      },
      "description": "要求 activation=ready、canonicalAuthReady、serviceListReady、registryFileReady、registryApiReady 和 wuxianPiHealth 全部为 true。"
    },
    {
      "id": "complete-resource-offer",
      "kind": "tool",
      "tool": "complete_apk_resource_offer",
      "description": "仅在宿主重新核验 offerId/sequence、activation=ready、canonical auth、服务列表、registry 和 WuxianPi health 后，将 APK offer 标记 satisfied。"
    }
  ]
}
