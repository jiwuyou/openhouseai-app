{
  "schemaVersion": 1,
  "id": "wuxianpi.first-install",
  "version": "1.0.14",
  "name": "首次安装",
  "description": "准备 Termux 基础环境，收敛最新核心资源，并独立完成资源安装和运行激活。",
  "category": "setup",
  "minHostVersion": 12,
  "requiredCapabilities": ["setup-tools", "termux", "persistent-terminal"],
  "tags": ["首次安装", "初始化", "Termux"],
  "entryWorkflow": "workflows/install.json",
  "assistantContexts": [
    { "path": "prompts/control-plane-triage.md", "scope": "session", "provider": "static" }
  ],
  "actions": [
    {
      "id": "first-install",
      "title": "完成首次安装",
      "icon": "download",
      "priority": 100,
      "prompt": "请根据当前设备的真实状态完成 WuxianPi 首次安装；先读取首次安装插件说明和工作流，已经完成的步骤应验证后跳过。",
      "visibleWhen": "always",
      "requiresPlugins": ["wuxianpi.first-install"]
    }
  ],
  "documents": [
    { "path": "docs/guide.md", "title": "首次安装说明" },
    { "path": "scripts/openhouse-control-plane-start", "title": "Android-Termux 固定入口" },
    { "path": "scripts/start-service-manager.sh", "title": "Termux service-manager 启动脚本" },
    { "path": "scripts/register-openhouse-component.sh", "title": "OpenHouse 桌面组件注册脚本" }
  ]
}
