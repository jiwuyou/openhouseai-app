<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rescue_shell_accent_soft" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/rescue_shell_text_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rescue_shell_panel" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/rescue_shell_border" />
        </shape>
    </item>
</selector>
